@model AMRSurveillance.Imports.Models.ImportViewModel<AMRSurveillance.Models.GeneReference>

@{
    ViewData["Title"] = "Import Gene References";

    var hasErrors = Model.Errors.Any();
    var hasRecords = Model.Records.Any();
    var canConfirm = Model.ReadyToImport;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Import Gene References</h2>
            <p class="text-muted mb-0">
                Import resistance gene reference records from Excel.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Gene References
        </a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Import Instructions</strong>
        </div>
        <div class="card-body">
            <ol>
                <li>Download the Gene Reference Excel template.</li>
                <li>Complete the gene names and relevant reference information.</li>
                <li>Save the file as an Excel .xlsx file.</li>
                <li>Upload the file and validate it.</li>
                <li>Review validation errors and confirm the import only when ready.</li>
            </ol>

            <a asp-action="DownloadImportTemplate"
               class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i>
                Download Gene Reference Template
            </a>
        </div>
    </div>

    @if (!Model.IsValidated)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <strong>Upload Excel File</strong>
            </div>
            <div class="card-body">
                <form asp-action="Import"
                      method="post"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="File" class="form-label">
                            Excel file
                        </label>
                        <input asp-for="File"
                               type="file"
                               class="form-control"
                               accept=".xlsx" />
                        <span asp-validation-for="File"
                              class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i>
                        Validate File
                    </button>
                </form>
            </div>
        </div>
    }

    @if (Model.IsValidated)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <strong>Validation Summary</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="border rounded p-3 text-center">
                            <div class="text-muted small">Total Rows</div>
                            <div class="fs-3 fw-bold">
                                @Model.Summary.TotalRows
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 text-center">
                            <div class="text-muted small">Valid Rows</div>
                            <div class="fs-3 fw-bold text-success">
                                @Model.Summary.SuccessfulRows
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 text-center">
                            <div class="text-muted small">Failed Rows</div>
                            <div class="fs-3 fw-bold text-danger">
                                @Model.Summary.FailedRows
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 text-center">
                            <div class="text-muted small">Errors</div>
                            <div class="fs-3 fw-bold text-danger">
                                @Model.Errors.Count
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (hasErrors)
        {
            <div class="card shadow-sm border-danger mb-4">
                <div class="card-header bg-danger text-white">
                    <strong>Validation Errors</strong>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Row</th>
                                    <th>Column</th>
                                    <th>Error</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var error in Model.Errors)
                                {
                                    <tr>
                                        <td>
                                            @(error.RowNumber > 0
                                                                            ? error.RowNumber.ToString()
                                                                            : "General")
                            </td>
                            <td>@(error.ColumnName ?? "—")</td>
                            <td>@error.Message</td>
                        </tr>
                                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (hasRecords)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between">
                    <strong>Validated Gene References</strong>
                    <span class="badge bg-success">
                        @Model.Records.Count valid record(s)
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Gene Name</th>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th>Applicable Organism</th>
                                    <th>Active</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var gene in Model.Records)
                                {
                                    <tr>
                                        <td class="fw-semibold">@gene.GeneName</td>
                                        <td>@(gene.GeneDescription ?? "—")</td>
                                        <td>@(gene.GeneCategory ?? "—")</td>
                                        <td>@(gene.ApplicableOrganism ?? "—")</td>
                                        <td>@(gene.IsActive ? "Yes" : "No")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    @if (canConfirm)
                    {
                        <h5 class="text-success mb-1">Ready for import</h5>
                        <p class="text-muted mb-0">
                            The validated records can be imported.
                        </p>
                    }
                    else
                    {
                        <h5 class="text-danger mb-1">Import blocked</h5>
                        <p class="text-muted mb-0">
                            Correct the validation errors and validate the file again.
                        </p>
                    }
                </div>

                <div class="d-flex gap-2">
                    @if (canConfirm)
                    {
                        <form asp-action="ConfirmImport" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-success"
                                    onclick="return confirm('Import these gene references and ensure their Genomics columns exist?');">
                                <i class="bi bi-database-add"></i>
                                Confirm Import
                            </button>
                        </form>
                    }

                    <form asp-action="ClearImport" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-outline-secondary">
                            Start Over
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <strong>Validate Another File</strong>
            </div>
            <div class="card-body">
                <form asp-action="Import"
                      method="post"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="row align-items-end g-3">
                        <div class="col-md-9">
                            <label asp-for="File" class="form-label">
                                Excel file
                            </label>
                            <input asp-for="File"
                                   type="file"
                                   class="form-control"
                                   accept=".xlsx" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">
                                Validate New File
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
