<div class="card shadow-sm border-0">

    <!-- ========================================= -->
    <!-- Questionnaire Navigation -->
    <!-- ========================================= -->

    <div class="card-header bg-primary text-white">

        <h6 class="mb-0 fw-semibold">
            <i class="bi bi-ui-checks-grid me-2"></i>
            Patient Questionnaire
        </h6>

    </div>


    <div class="list-group list-group-flush questionnaire-nav">

        <!-- Patient & Sample Information -->

        <a href="#"
           class="list-group-item list-group-item-action active"
           data-section="sample">

            <i class="bi bi-chevron-right nav-icon text-primary"></i>

            <span>Patient &amp; Sample Information</span>

        </a>


        <!-- Demographics -->

        <a href="#"
           class="list-group-item list-group-item-action"
           data-section="demographics">

            <i class="bi bi-circle nav-icon text-secondary"></i>

            <span>Demographics</span>

        </a>


        <!-- Personal History & Potential Risk Factors -->

        <a href="#"
           class="list-group-item list-group-item-action"
           data-section="risk">

            <i class="bi bi-circle nav-icon text-secondary"></i>

            <span>Personal History &amp; Potential Risk Factors</span>

        </a>


        <!-- Clinical Presentation -->

        <a href="#"
           class="list-group-item list-group-item-action"
           data-section="clinical">

            <i class="bi bi-circle nav-icon text-secondary"></i>

            <span>Clinical Presentation</span>

        </a>


        <!-- Clinical Assessment -->

        <a href="#"
           class="list-group-item list-group-item-action"
           data-section="assessment">

            <i class="bi bi-circle nav-icon text-secondary"></i>

            <span>Clinical Assessment</span>

        </a>


        <!-- Antibiotics & Infection-Related Information -->

        <a href="#"
           class="list-group-item list-group-item-action"
           data-section="antibiotics">

            <i class="bi bi-circle nav-icon text-secondary"></i>

            <span>Antibiotics &amp; Infection-Related Information</span>

        </a>


        <!-- Consent -->

        <a href="#"
           class="list-group-item list-group-item-action"
           data-section="consent">

            <i class="bi bi-circle nav-icon text-secondary"></i>

            <span>Consent</span>

        </a>

    </div>

</div>


<br />


<!-- ========================================= -->
<!-- Progress Card -->
<!-- ========================================= -->

<div class="card shadow-sm border-0">

    <div class="card-header">

        <strong>Progress</strong>

    </div>

    <div class="card-body">

        <div class="progress mb-3"
             style="height:10px;">

            <div id="formProgressBar"
                 class="progress-bar bg-success"
                 role="progressbar"
                 style="width:0%"
                 aria-valuenow="0"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>

        </div>


        <div class="small text-muted"
             id="formProgressText">

            0% complete

        </div>

    </div>

</div>