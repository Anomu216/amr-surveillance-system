                            <td>
                                <label class="mb-0" for="ChronicSkinConditionYes">
                                    Chronic Skin Condition
                                </label>
                            </td>

                            <td class="text-center">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="ChronicSkinCondition"
                                       value="Yes"
                                       id="ChronicSkinConditionYes" />

                            </td>

                            <td class="text-center">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="ChronicSkinCondition"
                                       value="No"
                                       id="ChronicSkinConditionNo" />

                            </td>

                        </tr>


