</div>

<script>
    (function () {
        const container = document.getElementById("riskFactorFields");
        const bulkActions = document.getElementById("riskFactorBulkActions");
        const isoNotice = document.getElementById("riskFactorIsoNotice");
        const allYesBtn = document.getElementById("selectAllRiskYesBtn");
        const allNoBtn = document.getElementById("selectAllRiskNoBtn");
        const clearAllBtn = document.getElementById("clearAllRiskBtn");

        if (!container || !allYesBtn || !allNoBtn) return;

        function syncIsoDisplayState() {
            const isHidden = container.classList.contains("d-none") ||
                container.style.display === "none";

            if (bulkActions) {
                bulkActions.classList.toggle("d-none", isHidden);
            }
            if (isoNotice) {
                isoNotice.classList.toggle("d-none", !isHidden);
            }
        }

        function getActiveRows() {
            return Array.from(container.querySelectorAll("tbody tr")).filter(row => {
                if (row.classList.contains("d-none") || window.getComputedStyle(row).display === "none") {
                    return false;
                }
                const anyEnabled = row.querySelector('input[type="radio"]:not(:disabled)');
                return Boolean(anyEnabled);
            });
        }

        function syncBulkButtonStates() {
            const rows = getActiveRows();
            const allYesChecked = rows.length > 0 && rows.every(row => {
                const r = row.querySelector('input[type="radio"][value="Yes"]:not(:disabled)');
                return r && r.checked;
            });
            const allNoChecked = rows.length > 0 && rows.every(row => {
                const r = row.querySelector('input[type="radio"][value="No"]:not(:disabled)');
                return r && r.checked;
            });

            allYesBtn.classList.toggle("active", allYesChecked);
            allYesBtn.setAttribute("aria-pressed", String(allYesChecked));

            allNoBtn.classList.toggle("active", allNoChecked);
            allNoBtn.setAttribute("aria-pressed", String(allNoChecked));
        }

        function clearAllRiskFactors() {
            const rows = getActiveRows();
            rows.forEach(row => {
                row.querySelectorAll('input[type="radio"]:not(:disabled)').forEach(r => {
                    if (r.checked) {
                        r.checked = false;
                        r.dispatchEvent(new Event("change", { bubbles: true }));
                    }
                });
            });
            syncBulkButtonStates();
        }

        function toggleAllRiskFactors(targetValue) {
            const rows = getActiveRows();
            if (rows.length === 0) return;

            const isAlreadyAllSelected = rows.every(row => {
                const radio = row.querySelector(`input[type="radio"][value="${targetValue}"]:not(:disabled)`);
                return radio && radio.checked;
            });

            if (isAlreadyAllSelected) {
                clearAllRiskFactors();
                return;
            }

            rows.forEach(row => {
                const targetRadio = row.querySelector(`input[type="radio"][value="${targetValue}"]:not(:disabled)`);
                if (targetRadio && !targetRadio.checked) {
                    targetRadio.checked = true;
                    targetRadio.dispatchEvent(new Event("change", { bubbles: true }));
                }
            });

            syncBulkButtonStates();
        }

        allYesBtn.addEventListener("click", () => toggleAllRiskFactors("Yes"));
        allNoBtn.addEventListener("click", () => toggleAllRiskFactors("No"));
        if (clearAllBtn) {
            clearAllBtn.addEventListener("click", clearAllRiskFactors);
        }

        container.querySelectorAll('input[type="radio"]').forEach(radio => {
            radio.addEventListener("dblclick", function () {
                if (!this.disabled && this.checked) {
                    this.checked = false;
                    this.dispatchEvent(new Event("change", { bubbles: true }));
                    syncBulkButtonStates();
                }
            });

            radio.addEventListener("change", syncBulkButtonStates);
        });

        const observer = new MutationObserver(syncIsoDisplayState);
        observer.observe(container, { attributes: true, attributeFilter: ["class", "style"] });

        syncIsoDisplayState();
        syncBulkButtonStates();
    })();
</script>