@model AMRSurveillance.ViewModels.PatientViewModel

<div class="card section-card">

    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">

        <div class="d-flex align-items-center min-w-0">

            <i class="bi bi-shield-check text-primary me-2 fs-4 flex-shrink-0"></i>

            <div class="min-w-0">

                <h5 class="mb-0">
                    Personal History &amp; Potential Risk Factors
                </h5>

                <small class="text-muted">
                    Record personal history and potential risk factors associated with antimicrobial resistance.
                </small>

            </div>

        </div>

        <div class="d-flex align-items-center flex-wrap gap-2" id="riskFactorBulkActions">

            <button type="button"
                    class="btn btn-sm btn-outline-primary text-nowrap"
                    id="selectAllRiskYesBtn">
                <i class="bi bi-check2-all me-1"></i>
                All Yes
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary text-nowrap"
                    id="selectAllRiskNoBtn">
                <i class="bi bi-x-circle me-1"></i>
                All No
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-danger text-nowrap"
                    id="clearAllRiskBtn"
                    title="Clear all selections (leave unentered)">
                <i class="bi bi-eraser me-1"></i>
                Clear
            </button>

        </div>

    </div>

    <div class="card-body">

        <div id="riskFactorIsoNotice" class="alert alert-secondary mb-0 d-none" role="status">
            <i class="bi bi-info-circle me-2"></i>
            Personal history and risk factors are <strong>Not Applicable (N/A)</strong> for ISO cases.
        </div>

        <div id="riskFactorFields">

            <div class="table-responsive">

                <table class="table table-bordered align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th scope="col">
                                Personal History / Potential Risk Factor
                            </th>

                            <th scope="col"
                                class="text-center"
                                style="width: 100px;">
                                Yes
                            </th>

                            <th scope="col"
                                class="text-center"
                                style="width: 100px;">
                                No
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        <!-- Chronic Illness -->

                        <tr>

                            <td>
                                <label class="mb-0" for="ChronicIllnessYes">
                                    Chronic Illness
                                </label>
                            </td>

                            <td class="text-center">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="ChronicIllness"
                                       value="Yes"
                                       id="ChronicIllnessYes" />

                            </td>

                            <td class="text-center">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="ChronicIllness"
                                       value="No"
                                       id="ChronicIllnessNo" />

                            </td>

                        </tr>


                        <!-- Chronic Skin Condition -->

