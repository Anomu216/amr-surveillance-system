@model AMRSurveillance.ViewModels.PatientViewModel

<div class="card section-card">

    <!-- ========================================= -->
    <!-- SECTION HEADER                            -->
    <!-- ========================================= -->

    <div class="card-header d-flex align-items-center">

        <i class="bi bi-people-fill text-primary me-2 fs-4"></i>

        <div>

            <h5 class="mb-0">
                Demographics &amp; Residence
            </h5>

            <small class="text-muted">
                Record participant demographic characteristics, occupation, and residential details.
            </small>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- SECTION BODY                              -->
    <!-- ========================================= -->

    <div class="card-body">

        <!-- ===================================== -->
        <!-- Core Demographics (All Case Types)    -->
        <!-- ===================================== -->

        <h6 class="text-primary border-bottom pb-2 mb-4">
            Core Demographics
        </h6>

        <div class="row g-4">

            <!-- Sex -->

            <div class="col-md-6">

                <label asp-for="Sex"
                       class="form-label fw-semibold">

                    Sex
                    <span class="text-danger">*</span>

                </label>

                <select asp-for="Sex"
                        asp-items="Model.SexList"
                        class="form-select"
                        id="Sex">
                </select>

                <div class="invalid-feedback"></div>

                <span asp-validation-for="Sex"
                      class="text-danger small"></span>

            </div>


            <!-- Date of Birth -->

            <div class="col-md-6">

                <label asp-for="DateOfBirth"
                       class="form-label fw-semibold">

                    Date of Birth

                </label>

                <input asp-for="DateOfBirth"
                       type="date"
                       class="form-control"
                       id="DateOfBirth"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                       autocomplete="off" />

                <div class="invalid-feedback"></div>

                <div class="form-text">
                    Optional if unknown; when entered, age must match enrollment date.
                </div>

                <span asp-validation-for="DateOfBirth"
                      class="text-danger small"></span>

            </div>


            <!-- Age -->

            <div class="col-md-6">

                <label asp-for="Age"
                       class="form-label fw-semibold">

                    Age
                    <span class="text-danger">*</span>

                </label>

                <input asp-for="Age"
                       type="number"
                       min="0"
                       step="1"
                       class="form-control"
                       id="Age"
                       placeholder="Enter whole-number age"
                       autocomplete="off" />

                <div class="invalid-feedback"
                     id="ageValidationFeedback"></div>

                <span asp-validation-for="Age"
                      class="text-danger small"></span>

            </div>


            <!-- Age Unit -->

            <div class="col-md-6">

                <label asp-for="AgeUnit"
                       class="form-label fw-semibold">

                    Age Unit
                    <span class="text-danger">*</span>

                </label>

                <select asp-for="AgeUnit"
                        asp-items="Model.AgeUnitList"
                        class="form-select"
                        id="AgeUnit">
                </select>

                <div class="invalid-feedback"></div>

                <span asp-validation-for="AgeUnit"
                      class="text-danger small"></span>

            </div>

        </div>


        <!-- ===================================== -->
        <!-- ISO Notice for Community Fields       -->
        <!-- ===================================== -->

        <div id="communityIsoNotice"
             class="alert alert-secondary mt-4 mb-0 d-none"
             role="status">
            <i class="bi bi-info-circle me-2"></i>
            Socioeconomic and residential details are <strong>Not Applicable (N/A)</strong> for ISO cases.
        </div>


        <!-- ===================================== -->
        <!-- Community & Residential Details       -->
        <!-- Hidden automatically for ISO cases    -->
        <!-- ===================================== -->

        <div id="communityFields">

            <h6 class="text-primary border-bottom pb-2 mt-5 mb-4">
                Occupation &amp; Household
            </h6>

            <div class="row g-4">

                <!-- Military / Civilian Status -->

                <div class="col-md-4">

                    <label asp-for="MILCIV"
                           class="form-label fw-semibold">

                        Military / Civilian Status

                    </label>

                    <select asp-for="MILCIV"
                            asp-items="Model.MilitaryCivilianList"
                            class="form-select"
                            id="MILCIV">
                    </select>

                    <div class="invalid-feedback"></div>

                    <span asp-validation-for="MILCIV"
                          class="text-danger small"></span>

                </div>


                <!-- Occupation Category -->

                <div class="col-md-4">

                    <label asp-for="OccupationCategory"
                           class="form-label fw-semibold">

                        Occupation Category

                    </label>

                    <select asp-for="OccupationCategory"
                            asp-items="Model.OccupationCategoryList"
                            class="form-select"
                            id="OccupationCategory">
                    </select>

                    <div class="invalid-feedback"></div>

                    <span asp-validation-for="OccupationCategory"
                          class="text-danger small"></span>

                </div>


                <!-- Household Size -->

                <div class="col-md-4">

                    <label asp-for="HouseholdSize"
                           class="form-label fw-semibold">

                        Household Size

                    </label>

                    <input asp-for="HouseholdSize"
                           type="number"
                           min="1"
                           max="100"
                           step="1"
                           class="form-control"
                           id="HouseholdSize"
                           placeholder="Number of household members"
                           autocomplete="off" />

                    <div class="invalid-feedback"></div>

                    <span asp-validation-for="HouseholdSize"
                          class="text-danger small"></span>

                </div>

            </div>


            <h6 class="text-primary border-bottom pb-2 mt-5 mb-4">
                Residence Information
            </h6>

            <div class="row g-4">

                <!-- Residence County -->

                <div class="col-md-6">

                    <label asp-for="ResidenceCounty"
                           class="form-label fw-semibold">

                        County of Residence
                        <span class="text-danger">*</span>

                    </label>

                    <select asp-for="ResidenceCounty"
                            asp-items="Model.CountyList"
                            class="form-select"
                            id="ResidenceCounty"
                            data-subcounty-url="@Url.Action("GetSubCounties", "Patient")">
                    </select>

                    <div class="invalid-feedback"></div>

                    <span asp-validation-for="ResidenceCounty"
                          class="text-danger small"></span>

                </div>


                <!-- Residence Sub-County (Cascaded from County) -->

                <div class="col-md-6">

                    <label asp-for="ResidenceSubCounty"
                           class="form-label fw-semibold">

                        Sub-County of Residence
                        <span class="text-danger">*</span>

                    </label>

                    <select asp-for="ResidenceSubCounty"
                            asp-items="Model.SubCountyList"
                            class="form-select"
                            id="ResidenceSubCounty">
                    </select>

                    <div class="invalid-feedback"></div>

                    <span asp-validation-for="ResidenceSubCounty"
                          class="text-danger small"></span>

                </div>


                <!-- Residence Village / Estate -->

                <div class="col-md-6">

                    <label asp-for="ResidenceVillage"
                           class="form-label fw-semibold">

                        Village / Estate

                    </label>

                    <input asp-for="ResidenceVillage"
                           type="text"
                           class="form-control"
                           id="ResidenceVillage"
                           placeholder="Enter village or estate name"
                           autocomplete="off" />

                    <div class="invalid-feedback"></div>

                    <span asp-validation-for="ResidenceVillage"
                          class="text-danger small"></span>

                </div>


                <!-- Residence Description (Urban / Peri-Urban / Rural) -->

                <div class="col-md-6">

                    <label asp-for="ResidenceDescription"
                           class="form-label fw-semibold">

                        Residence Setting / Description

                    </label>

                    <select asp-for="ResidenceDescription"
                            asp-items="Model.ResidenceDescriptionList"
                            class="form-select"
                            id="ResidenceDescription">
                    </select>

                    <div class="invalid-feedback"></div>

                    <span asp-validation-for="ResidenceDescription"
                          class="text-danger small"></span>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    (function () {
        const communityFields = document.getElementById("communityFields");
        const isoNotice = document.getElementById("communityIsoNotice");

        if (!communityFields || !isoNotice) return;

        function syncCommunityIsoDisplayState() {
            const isHidden = communityFields.classList.contains("d-none") ||
                communityFields.style.display === "none";
            isoNotice.classList.toggle("d-none", !isHidden);
        }

        const observer = new MutationObserver(syncCommunityIsoDisplayState);
        observer.observe(communityFields, { attributes: true, attributeFilter: ["class", "style"] });

        syncCommunityIsoDisplayState();
    })();
</script>