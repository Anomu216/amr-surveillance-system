@model IEnumerable<AMRSurveillance.ViewModels.WorksheetViewModel>

@{
    ViewData["Title"] = "Worksheets";
    ViewData["ActivePage"] = "Worksheet";
    var records = Model?.ToList() ?? [];
}

<div class="container-fluid">

    <!-- =====================================================
         Page Header
         ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Worksheets</h2>

            <p class="text-muted mb-0">
                Laboratory isolate and antimicrobial susceptibility records.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Worksheet"
               asp-action="Import"
               class="btn btn-outline-success">

                <i class="bi bi-file-earmark-arrow-up"></i>
                Import Worksheets

            </a>

            <a asp-controller="Worksheet"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-lg"></i>
                New Worksheet

            </a>

        </div>

    </div>

    <!-- =====================================================
         Success / Error Messages
         ===================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- =====================================================
         Search
         ===================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-controller="Worksheet"
                  asp-action="Index"
                  method="get">

                <div class="row g-2">

                    <div class="col-md-10">

                        <label for="search"
                               class="form-label">
                            Search Worksheets
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search by Isolate ID, Patient ID, Manuscript ID, WHONET ID or AST Card..."
                               autocomplete="off" />

                    </div>

                    <div class="col-md-2 d-flex align-items-end">

                        <div class="d-flex gap-2 w-100">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">

                                <i class="bi bi-search"></i>
                                Search

                            </button>

                            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
                            {
                                <a asp-controller="Worksheet"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary"
                                   title="Clear search">

                                    <i class="bi bi-x-lg"></i>

                                </a>
                            }

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- =====================================================
         Worksheet Table
         ===================================================== -->

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                Worksheet Records
            </h5>

            <span class="badge bg-secondary">
                @records.Count record(s)
            </span>

        </div>

        <div class="card-body p-0">

            @if (records.Count == 0)
            {
                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-clipboard-x fs-1 text-muted"></i>

                    </div>

                    <h5>
                        No worksheet records found
                    </h5>

                    <p class="text-muted mb-3">

                        @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
                        {
                            <span>
                                No records matched your search.
                            </span>
                        }
                        else
                        {
                            <span>
                                No worksheet records have been entered yet.
                            </span>
                        }

                    </p>

                    @if (string.IsNullOrWhiteSpace(ViewBag.Search as string))
                    {
                        <a asp-controller="Worksheet"
                           asp-action="Create"
                           class="btn btn-primary">

                            <i class="bi bi-plus-lg"></i>
                            Create First Worksheet

                        </a>
                    }

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover table-bordered align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Isolate ID
                                </th>

                                <th>
                                    Patient ID
                                </th>

                                <th>
                                    Manuscript ID
                                </th>

                                <th>
                                    Culture Result
                                </th>

                                <th>
                                    WHONET ID
                                </th>

                                <th>
                                    AST Card(s)
                                </th>

                                <th>
                                    MDR
                                </th>

                                <th style="width: 150px;">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in records)
                            {
                                var cardsText = item.ASTCards is { Count: > 0 }
                                ? string.Join("; ", item.ASTCards)
                                : string.Empty;

                                <tr>

                                    <!-- Isolate ID -->
                                    <td>
                                        <strong>
                                            @item.IsolateID
                                        </strong>
                                    </td>

                                    <!-- Patient ID -->
                                    <td>
                                        @item.PatientID
                                    </td>

                                    <!-- Manuscript ID -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.ManuscriptID))
                                        {
                                            @item.ManuscriptID
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <!-- Culture Result -->
                                    <td>
                                        @item.CultureResult
                                    </td>

                                    <!-- WHONET ID -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.WHONETID))
                                        {
                                            <span class="badge bg-secondary">
                                                @item.WHONETID
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <!-- AST Card(s) -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(cardsText))
                                        {
                                            @cardsText
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <!-- MDR -->
                                    <td>
                                        @if (item.MDR == true)
                                        {
                                            <span class="badge bg-danger">
                                                MDR
                                            </span>
                                        }
                                        else if (item.MDR == false)
                                        {
                                            <span class="badge bg-success">
                                                Non-MDR
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td>

                                        <div class="d-flex gap-1">

                                            <a asp-controller="Worksheet"
                                               asp-action="Edit"
                                               asp-route-id="@item.IsolateID"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit worksheet">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    data-isolate-id="@item.IsolateID"
                                                    title="Delete worksheet">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

<!-- =========================================================
     Delete Confirmation Modal
     ========================================================= -->

<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="deleteModalLabel">

                    Delete Worksheet

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <p class="mb-2">
                    Are you sure you want to delete this worksheet?
                </p>

                <p class="mb-0">
                    <strong>Isolate ID:</strong>
                    <span id="deleteIsolateID"></span>
                </p>

                <div class="alert alert-warning mt-3 mb-0">

                    This action cannot be undone.

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

                <form asp-controller="Worksheet"
                      asp-action="Delete"
                      method="post"
                      id="deleteForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           id="deleteWorksheetID" />

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash"></i>
                        Delete

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const deleteModal =
                    document.getElementById("deleteModal");

                if (!deleteModal)
                    return;

                deleteModal.addEventListener(
                    "show.bs.modal",
                    function (event) {

                        const button =
                            event.relatedTarget;

                        const isolateID =
                            button.getAttribute(
                                "data-isolate-id");

                        document.getElementById(
                            "deleteIsolateID")
                            .textContent =
                            isolateID;

                        document.getElementById(
                            "deleteWorksheetID")
                            .value =
                            isolateID;

                    });

            });

    </script>
}