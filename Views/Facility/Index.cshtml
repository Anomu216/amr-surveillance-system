@model IEnumerable<AMRSurveillance.Models.Facility>

@{
    ViewData["Title"] = "Facility Management";
}

<partial name="_PageHeader" />

<div class="container-fluid">

    <div class="card shadow-sm border-0">

        <!-- ========================================= -->
        <!-- Header -->
        <!-- ========================================= -->

        <div class="card-header bg-primary text-white d-flex flex-column flex-md-row justify-content-between align-items-md-center">

            <h4 class="mb-3 mb-md-0">

                <i class="bi bi-hospital me-2"></i>

                Facility Management

            </h4>

            <div class="d-flex flex-wrap gap-2">

                <a asp-action="Import"
                   class="btn btn-success">

                    <i class="bi bi-upload me-2"></i>

                    Import

                </a>

                <a asp-action="Create"
                   class="btn btn-light">

                    <i class="bi bi-plus-circle me-2"></i>

                    Add Facility

                </a>

            </div>

        </div>

        <!-- ========================================= -->
        <!-- Body -->
        <!-- ========================================= -->

        <div class="card-body">

            <div class="row align-items-center g-3 mb-4">

                <div class="col-lg-6">

                    <input type="text"
                           id="facilitySearch"
                           class="form-control"
                           placeholder="Search by code, facility, county or ownership..." />

                </div>

                <div class="col-lg-6 text-lg-end">

                    <span class="fw-semibold">

                        Total Facilities:

                        <span class="badge bg-primary">

                            @Model.Count()

                        </span>

                    </span>

                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle mb-0"
                       id="facilityTable">

                    <thead class="table-dark">

                        <tr>

                            <th>Code</th>

                            <th>Facility Name</th>

                            <th>County</th>

                            <th>Sub County</th>

                            <th>Level</th>

                            <th>Ownership</th>

                            <th class="text-center" style="width:170px">

                                Actions

                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <strong>

                                        @item.FacilityID

                                    </strong>

                                </td>

                                <td>

                                    @item.FacilityName

                                </td>

                                <td>

                                    @item.County

                                </td>

                                <td>

                                    @item.SubCounty

                                </td>

                                <td>

                                    @item.FacilityLevel

                                </td>

                                <td>

                                    @item.Ownership

                                </td>

                                <td class="text-center">

                                    <div class="btn-group btn-group-sm">

                                        <a asp-action="Details"
                                           asp-route-id="@item.FacilityID"
                                           class="btn btn-outline-info"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.FacilityID"
                                           class="btn btn-outline-warning"
                                           title="Edit Facility">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        document
            .getElementById("facilitySearch")
            .addEventListener("keyup", function () {

                let value = this.value.toLowerCase();

                let rows = document.querySelectorAll("#facilityTable tbody tr");

                rows.forEach(function (row) {

                    row.style.display =
                        row.innerText.toLowerCase().includes(value)
                            ? ""
                            : "none";

                });

            });

    </script>
}