@model AMRSurveillance.Imports.Models.ImportViewModel<AMRSurveillance.Models.Facility>

@{
    ViewData["Title"] = "Import Facilities";
}

<div class="container-fluid">

    <!-- ============================================= -->
    <!-- Page Header -->
    <!-- ============================================= -->

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                Import Facilities

            </h2>

            <p class="text-muted mb-0">

                Upload an Excel file to import facilities into the AMR Surveillance System.

            </p>

        </div>

        <div class="mt-3 mt-lg-0">

            <a asp-action="DownloadTemplate"
               class="btn btn-outline-success">

                <i class="bi bi-download me-2"></i>

                Download Template

            </a>

        </div>

    </div>

    <!-- ============================================= -->
    <!-- Upload -->
    <!-- ============================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Import"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="row align-items-end g-3">

                    <div class="col-lg-9">

                        <label class="form-label fw-semibold">

                            Excel File

                        </label>

                        <input asp-for="File"
                               type="file"
                               accept=".xlsx"
                               class="form-control" />

                        <span asp-validation-for="File"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-lg-3 d-grid">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-circle me-2"></i>

                            Validate File

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- ============================================= -->
    <!-- Validation Summary -->
    <!-- ============================================= -->
    @if (Model.IsValidated)
    {
        <div class="row g-3 mb-4">

            <div class="col-lg-4 col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center">

                        <h2 class="fw-bold text-primary">

                            @Model.Summary.TotalRows

                        </h2>

                        <div class="text-muted">

                            Total Rows

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-lg-4 col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center">

                        <h2 class="fw-bold text-success">

                            @Model.Summary.SuccessfulRows

                        </h2>

                        <div class="text-muted">

                            Valid Records

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-lg-4 col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center">

                        <h2 class="fw-bold text-danger">

                            @Model.Summary.FailedRows

                        </h2>

                        <div class="text-muted">

                            Errors

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- ============================================= -->
    <!-- Validation Errors -->
    <!-- ============================================= -->
    @if (Model.Errors.Any())
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-danger text-white">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                Validation Errors

            </div>

            <div class="table-responsive">

                <table class="table table-striped table-hover mb-0">

                    <thead>

                        <tr>

                            <th style="width:120px">

                                Row

                            </th>

                            <th style="width:200px">

                                Column

                            </th>

                            <th>

                                Message

                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var error in Model.Errors)
                        {
                            <tr>

                                <td>

                                    @error.RowNumber

                                </td>

                                <td>

                                    @error.ColumnName

                                </td>

                                <td>

                                    @error.Message

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

    <!-- ============================================= -->
    <!-- Preview -->
    <!-- ============================================= -->
    @if (Model.Records.Any())
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header">

                <i class="bi bi-table me-2"></i>

                Records Ready For Import

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>

                                Facility ID

                            </th>

                            <th>

                                Facility Name

                            </th>

                            <th>

                                County

                            </th>

                            <th>

                                Sub County

                            </th>

                            <th>

                                Level

                            </th>

                            <th>

                                Ownership

                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var facility in Model.Records)
                        {
                            <tr>

                                <td>

                                    @facility.FacilityID

                                </td>

                                <td>

                                    @facility.FacilityName

                                </td>

                                <td>

                                    @facility.County

                                </td>

                                <td>

                                    @facility.SubCounty

                                </td>

                                <td>

                                    @facility.FacilityLevel

                                </td>

                                <td>

                                    @facility.Ownership

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

    <!-- ============================================= -->
    <!-- Confirm Import -->
    <!-- ============================================= -->
    @if (Model.ReadyToImport)
    {
        <div class="d-flex flex-column flex-md-row justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                Cancel

            </a>

            <form asp-action="ConfirmImport"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-success">

                    <i class="bi bi-cloud-upload me-2"></i>

                    Confirm Import

                </button>

            </form>

        </div>
    }

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}