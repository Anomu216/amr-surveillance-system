                    }

                    <!-- ================================================= -->
                    <!-- INTERACTIVE ANTIBIOTIC RESISTANCE TRENDS (ALWAYS VISIBLE) -->
                    <!-- ================================================= -->
                    <div class="ast-trends-section">
