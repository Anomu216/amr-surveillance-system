</div>


@section Scripts {

    <!-- Serialized Dashboard Payload (Zero JS Parser Warnings) -->
    <script id="amr-dashboard-data" type="application/json">
        @Html.Raw(JsonSerializer.Serialize(new
        {
                        patientsBySex = Model.PatientsBySex,
                                        patientsByAgeGroup = Model.PatientsByAgeGroup,
                                        militaryCivilian = Model.PatientsByMilitaryCivilianStatus,
                                        patientType = Model.PatientsByPatientType,
                                        haiCai = Model.PatientsByHAICAI,
                                        clinicalPresentation = Model.PatientsByClinicalPresentation,
                                        isolatesByOrganism = Model.IsolatesByOrganism,
                                        cultureResults = Model.CultureResults,
                                        antibioticSusceptibility = Model.AntibioticSusceptibility,
                                        antibiogram = Model.Antibiogram,
                                        antibioticTrendObservations = Model.AntibioticTrendObservations,
                                        isGroupedByRecruitmentType = Model.IsGroupedByRecruitmentType,
                                        sequencingOverTime = Model.SequencingOverTime,
                                        genomeCompleteness = Model.GenomeCompleteness,
                                        strainTypes = Model.StrainTypesData,
                                        genePrevalence = Model.GenePrevalence,
                                        genomicScores = Model.GenomicScores,
                                        genomicFilterCount = genomicFilterCount
        }, jsonOptions))
</script>

<!-- Plotly -->
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>

<script>

    // =========================================================
    // LIVE DASHBOARD DATA
    // =========================================================

    const dashboardDataEl = document.getElementById("amr-dashboard-data");
    const dashboardData = dashboardDataEl ? JSON.parse(dashboardDataEl.textContent || "{}") : {};

    const patientsBySex = dashboardData.patientsBySex || [];
    const patientsByAgeGroup = dashboardData.patientsByAgeGroup || [];
    const militaryCivilian = dashboardData.militaryCivilian || [];
    const patientType = dashboardData.patientType || [];
    const haiCai = dashboardData.haiCai || [];
    const clinicalPresentation = dashboardData.clinicalPresentation || [];

    const isolatesByOrganism = dashboardData.isolatesByOrganism || [];
    const cultureResults = dashboardData.cultureResults || [];
    const antibioticSusceptibility = dashboardData.antibioticSusceptibility || [];
    const antibiogram = dashboardData.antibiogram || [];
    const antibioticTrendObservations = dashboardData.antibioticTrendObservations || [];
    const isGroupedByRecruitmentType = Boolean(dashboardData.isGroupedByRecruitmentType);

    const sequencingOverTime = dashboardData.sequencingOverTime || [];
    const genomeCompleteness = dashboardData.genomeCompleteness || [];
    const strainTypes = dashboardData.strainTypes || [];
    const genePrevalence = dashboardData.genePrevalence || [];
    const genomicScores = dashboardData.genomicScores || [];

    const genomicFilterCount = Number(dashboardData.genomicFilterCount) || 0;


    // =========================================================
    // RECRUITMENT FILTER / GROUP-BY SWITCH INTERACTION
    // =========================================================

    function initRecruitmentControls() {
        const recruitmentSelect = document.getElementById("recruitmentTypeSelect");
        const groupSwitch = document.getElementById("groupByRecruitmentSwitch");
        if (!recruitmentSelect || !groupSwitch) return;

        function syncSwitchState() {
            const hasSingleRecruitment = Boolean(recruitmentSelect.value && recruitmentSelect.value.trim() !== "");
            if (hasSingleRecruitment) {
                groupSwitch.checked = false;
                groupSwitch.disabled = true;
            } else {
                groupSwitch.disabled = false;
            }
        }

        recruitmentSelect.addEventListener("change", syncSwitchState);
        syncSwitchState();
    }


    // =========================================================
    // MULTI-CHECKBOX DROPDOWN INITIALIZATION
    // =========================================================

    function bindMultiCheckDropdown(dropdown) {
        if (!dropdown) return;

        const placeholder = dropdown.dataset.placeholder || "Select options";
        const itemLabel = dropdown.dataset.itemLabel || "item";
        const itemsLabel = dropdown.dataset.itemsLabel || "items";
        const summaryEl = dropdown.querySelector(".multi-check-summary");
        const searchInput = dropdown.querySelector(".multi-check-search");
        const selectAllBtn = dropdown.querySelector(".multi-check-all");
        const clearBtn = dropdown.querySelector(".multi-check-clear");
        const items = Array.from(dropdown.querySelectorAll(".multi-check-item"));
        const checkboxes = Array.from(dropdown.querySelectorAll(".multi-check-input"));

        function updateSummary() {
            const checkedBoxes = checkboxes.filter(cb => cb.checked);
            if (checkedBoxes.length === 0) {
                summaryEl.textContent = placeholder;
                summaryEl.classList.remove("fw-semibold", "text-primary");
            } else if (checkedBoxes.length === 1) {
                const label = checkedBoxes[0].closest(".multi-check-item").querySelector("label");
                summaryEl.textContent = label ? label.textContent.trim() : `1 ${itemLabel} selected`;
                summaryEl.classList.add("fw-semibold", "text-primary");
            } else {
                summaryEl.textContent = `${checkedBoxes.length} ${itemsLabel} selected`;
                summaryEl.classList.add("fw-semibold", "text-primary");
            }
        }

        checkboxes.forEach(cb => cb.addEventListener("change", () => {
            updateSummary();
            dropdown.dispatchEvent(new CustomEvent("multicheck:change"));
        }));

        if (searchInput) {
            searchInput.addEventListener("input", function () {
                const term = this.value.trim().toLowerCase();
                items.forEach(item => {
                    const text = item.dataset.searchText || "";
                    item.style.display = text.includes(term) ? "" : "none";
                });
            });
        }

        if (selectAllBtn) {
            selectAllBtn.addEventListener("click", function () {
                items.forEach(item => {
                    if (item.style.display !== "none") {
                        const cb = item.querySelector(".multi-check-input");
                        if (cb) cb.checked = true;
                    }
                });
                updateSummary();
                dropdown.dispatchEvent(new CustomEvent("multicheck:change"));
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener("click", function () {
                checkboxes.forEach(cb => { cb.checked = false; });
                updateSummary();
                dropdown.dispatchEvent(new CustomEvent("multicheck:change"));
            });
        }

        updateSummary();
    }

    function initMultiCheckDropdowns() {
        document.querySelectorAll(".multi-check-dropdown").forEach(dropdown => {
