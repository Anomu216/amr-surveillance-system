    // =========================================================
    // INTERACTIVE LONGITUDINAL ANTIBIOTIC RESISTANCE TRENDS
    // =========================================================

    function computeDynamicTrendYAxisMax(maxObservedPct) {
        if (!Number.isFinite(maxObservedPct) || maxObservedPct <= 0) {
            return 5;
        }
        if (maxObservedPct < 5) {
            return Math.max(2, Math.ceil(maxObservedPct * 1.25));
        }
        if (maxObservedPct < 15) {
            return Math.ceil((maxObservedPct * 1.2) / 2) * 2;
        }
        if (maxObservedPct < 50) {
            return Math.ceil((maxObservedPct * 1.15) / 5) * 5;
        }
        return Math.min(100, Math.ceil((maxObservedPct * 1.1) / 10) * 10);
    }

    function initResistanceTrends() {
        const chartEl = document.getElementById("resistanceTrendsChart");
        const dropdownEl = document.getElementById("trendAntibioticDropdown");
        const checkListEl = document.getElementById("trendAntibioticCheckList");
        const btnTrendline = document.getElementById("btnToggleTrendline");
        const slopeSummaryEl = document.getElementById("trendSlopeSummary");

        if (!chartEl || !dropdownEl || !checkListEl) return;

        if (!Array.isArray(antibioticTrendObservations) || antibioticTrendObservations.length === 0) {
            showNoData("resistanceTrendsChart", "No longitudinal AST dates available for selected organism(s)");
            return;
        }

        let showTrendline = false;

        const abxTotals = new Map();
        antibioticTrendObservations.forEach(obs => {
            const existing = abxTotals.get(obs.antibioticCode) || {
                code: obs.antibioticCode,
                name: obs.antibioticName || obs.antibioticCode,
                tested: 0
            };
            existing.tested += Number(obs.tested) || 0;
            abxTotals.set(obs.antibioticCode, existing);
        });

        const sortedAbx = Array.from(abxTotals.values())
            .sort((a, b) => b.tested - a.tested || a.name.localeCompare(b.name));

        // Do not auto-select any antibiotics on load — let the user choose
        checkListEl.innerHTML = sortedAbx.map(abx => {
            const checkId = `trend_abx_${abx.code}`;
            const searchText = `${abx.name} ${abx.code}`.toLowerCase();
            return `
                <div class="form-check multi-check-item" data-search-text="${searchText}">
                    <input class="form-check-input multi-check-input"
                           type="checkbox"
                           value="${abx.code}"
                           id="${checkId}" />
                    <label class="form-check-label small" for="${checkId}">
                        ${abx.name} (${abx.code}) &mdash; n=${abx.tested}
                    </label>
                </div>
            `;
        }).join("");

        bindMultiCheckDropdown(dropdownEl);

        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

        function getBucketInfo(year, month, granularity) {
            if (granularity === "quarter") {
                const q = Math.floor((month - 1) / 3) + 1;
                return { key: `${year}-Q${q}`, label: `Q${q} ${year}`, sortOrder: year * 10 + q };
            }
            if (granularity === "semiannual") {
                const h = month <= 6 ? 1 : 2;
                return {
                    key: `${year}-H${h}`,
                    label: `H${h} ${year} (${h === 1 ? "Jan–Jun" : "Jul–Dec"})`,
                    sortOrder: year * 10 + h
                };
            }
            if (granularity === "year") {
                return { key: `${year}`, label: `${year}`, sortOrder: year };
            }
            return {
                key: `${year}-${String(month).padStart(2, "0")}`,
                label: `${monthNames[month - 1]} ${year}`,
                sortOrder: year * 100 + month
            };
        }

        function computeOLS(values) {
            const pts = [];
            values.forEach((v, idx) => {
                if (v !== null && v !== undefined && !Number.isNaN(v)) {
                    pts.push({ x: idx, y: v });
                }
            });
            if (pts.length < 2) return null;

            const n = pts.length;
            const sumX = pts.reduce((acc, p) => acc + p.x, 0);
            const sumY = pts.reduce((acc, p) => acc + p.y, 0);
            const sumXY = pts.reduce((acc, p) => acc + p.x * p.y, 0);
            const sumXX = pts.reduce((acc, p) => acc + p.x * p.x, 0);

            const denom = (n * sumXX) - (sumX * sumX);
            if (denom === 0) return null;

            const slope = ((n * sumXY) - (sumX * sumY)) / denom;
            const intercept = (sumY - (slope * sumX)) / n;

            const line = values.map((_, idx) => {
                const projected = intercept + slope * idx;
                return Math.max(0, Math.min(100, Number(projected.toFixed(2))));
            });

            return { slope, intercept, line };
        }

        function renderTrendsChart() {
            const selectedCodes = Array.from(checkListEl.querySelectorAll(".multi-check-input:checked"))
                .map(cb => cb.value);

            if (selectedCodes.length === 0) {
                showNoData("resistanceTrendsChart", "Select one or more antibiotics above to plot resistance trends");
                if (slopeSummaryEl) slopeSummaryEl.innerHTML = "";
                return;
            }

            const granularityEl = document.querySelector('input[name="trendGranularity"]:checked');
            const granularity = granularityEl ? granularityEl.value : "month";

            const bucketMap = new Map();
            const cellAgg = new Map();

            antibioticTrendObservations.forEach(obs => {
                const b = getBucketInfo(obs.year, obs.month, granularity);
                bucketMap.set(b.key, b);

                if (!selectedCodes.includes(obs.antibioticCode)) return;

                const recGroup = isGroupedByRecruitmentType ? (obs.recruitmentType || "Active") : "Overall";
                const cellKey = `${obs.antibioticCode}|${recGroup}|${b.key}`;
                const cur = cellAgg.get(cellKey) || { resistant: 0, tested: 0 };
                cur.resistant += Number(obs.resistant) || 0;
                cur.tested += Number(obs.tested) || 0;
                cellAgg.set(cellKey, cur);
            });

            const sortedBuckets = Array.from(bucketMap.values())
                .sort((a, b) => a.sortOrder - b.sortOrder);

            const labels = sortedBuckets.map(b => b.label);
            const traces = [];
            const slopeNotes = [];
            let maxObservedPct = 0;

            const seriesGroups = isGroupedByRecruitmentType ? ["Active", "Passive"] : ["Overall"];

            selectedCodes.forEach((code, idx) => {
                const color = pubPalette[idx % pubPalette.length];
                const meta = abxTotals.get(code);
                const baseName = meta ? `${meta.name} (${code})` : code;

                seriesGroups.forEach(recGroup => {
                    const isPassive = recGroup === "Passive";
                    const seriesLabel = isGroupedByRecruitmentType
                        ? `${baseName} [${isPassive ? "Passive (ISO)" : "Active"}]`
                        : baseName;

                    const yValues = sortedBuckets.map(b => {
                        const agg = cellAgg.get(`${code}|${recGroup}|${b.key}`);
                        if (!agg || agg.tested === 0) return null;
                        const pct = Number(((agg.resistant / agg.tested) * 100).toFixed(2));
                        if (pct > maxObservedPct) maxObservedPct = pct;
                        return pct;
                    });

                    if (yValues.every(v => v === null)) {
                        return;
                    }

                    const hoverDetails = sortedBuckets.map(b => {
                        const agg = cellAgg.get(`${code}|${recGroup}|${b.key}`);
                        if (!agg || agg.tested === 0) return "Not tested";
                        const pct = ((agg.resistant / agg.tested) * 100).toFixed(1);
                        return `${pct}% resistant (${agg.resistant}/${agg.tested})`;
                    });

                    traces.push({
                        type: "scatter",
                        mode: "lines+markers",
                        name: seriesLabel,
                        x: labels,
                        y: yValues,
                        customdata: hoverDetails,
                        connectgaps: true,
                        line: {
                            color: color,
                            width: 2.5,
                            dash: isPassive ? "dash" : "solid"
                        },
                        marker: {
                            color: color,
                            size: 7.5,
                            symbol: isPassive ? "diamond" : "circle",
                            line: { color: "#ffffff", width: 1.5 }
                        },
                        hovertemplate: `<b>${seriesLabel}</b><br>%{x}: %{customdata}<extra></extra>`
                    });

                    if (showTrendline) {
                        const ols = computeOLS(yValues);
                        if (ols) {
                            ols.line.forEach(val => {
                                if (val > maxObservedPct) maxObservedPct = val;
                            });
                            const sign = ols.slope >= 0 ? "+" : "";
                            const slopeLabel = isGroupedByRecruitmentType ? `${code} (${recGroup})` : code;
                            slopeNotes.push(`<strong>${slopeLabel}</strong>: ${sign}${ols.slope.toFixed(2)}% per ${granularity}`);
                            traces.push({
                                type: "scatter",
                                mode: "lines",
                                name: `${slopeLabel} Trend (${sign}${ols.slope.toFixed(2)}%/period)`,
                                x: labels,
                                y: ols.line,
                                line: { color: color, width: 1.8, dash: "dot" },
                                hovertemplate: `<b>${slopeLabel} Linear Trend</b><br>%{x}: %{y:.1f}%<extra></extra>`
                            });
                        }
                    }
                });
            });

            if (traces.length === 0) {
                showNoData("resistanceTrendsChart", "No resistance observations available for the selected antibiotic(s)");
                if (slopeSummaryEl) slopeSummaryEl.innerHTML = "";
                return;
            }

            const yAxisMax = computeDynamicTrendYAxisMax(maxObservedPct);

            const layout = {
                ...getPublicationLayout(),
                font: {
                    family: "Inter, 'Segoe UI', Arial, sans-serif",
                    size: 13,
                    color: "#0f172a"
                },
                margin: { l: 65, r: 25, t: 36, b: 68 },
                xaxis: {
                    showline: true,
                    linecolor: "#94a3b8",
                    ticks: "outside",
                    tickcolor: "#94a3b8",
                    tickangle: labels.length > 8 ? -30 : 0,
                    tickfont: { size: 12.5, color: "#1e293b" },
                    showgrid: false
                },
                yaxis: {
                    range: [0, yAxisMax],
                    showline: true,
                    linecolor: "#94a3b8",
                    ticks: "outside",
                    tickcolor: "#94a3b8",
                    tickfont: { size: 12.5, color: "#1e293b" },
                    title: { text: "Resistant Isolates (%R)", font: { size: 13, color: "#334155" } },
                    gridcolor: "#f1f5f9",
                    zeroline: false
                },
                legend: {
                    orientation: "h",
                    x: 0.5,
                    xanchor: "center",
                    y: 1.12,
                    yanchor: "bottom",
                    font: { size: 12.5, color: "#0f172a" }
                }
            };

            Plotly.newPlot("resistanceTrendsChart", traces, layout, { responsive: true, displayModeBar: false });

            if (slopeSummaryEl) {
                slopeSummaryEl.innerHTML = showTrendline && slopeNotes.length > 0
                    ? `<i class="bi bi-calculator me-1"></i>OLS Trend Slopes: ${slopeNotes.join(" &bull; ")}`
                    : "";
            }
        }

        dropdownEl.addEventListener("multicheck:change", renderTrendsChart);
        document.querySelectorAll('input[name="trendGranularity"]').forEach(radio => {
            radio.addEventListener("change", renderTrendsChart);
        });

        if (btnTrendline) {
            btnTrendline.addEventListener("click", function () {
                showTrendline = !showTrendline;
                btnTrendline.setAttribute("aria-pressed", String(showTrendline));
                btnTrendline.classList.toggle("btn-dark", showTrendline);
                btnTrendline.classList.toggle("btn-outline-dark", !showTrendline);
                const spanEl = btnTrendline.querySelector("span");
                if (spanEl) {
                    spanEl.textContent = showTrendline ? "Hide Trendline" : "Add Trendline";
                }
                renderTrendsChart();
            });
        }

        renderTrendsChart();
    }


    // =========================================================
    // GENOMIC FILTER STATUS & TAB RESIZING
    // =========================================================

    function updateGenomicFilterStatus() {
        const status = document.getElementById("genomicFilterStatus");
        if (!status) return;

        status.textContent = genomicFilterCount === 0
            ? "All accepted sequenced isolates"
            : `${genomicFilterCount} genomic filter(s) active`;
    }

    function resizeVisibleCharts() {
        document.querySelectorAll(".plotly-chart").forEach(chart => {
            if (chart.offsetParent !== null && chart.data) {
                Plotly.Plots.resize(chart);
            }
        });
    }


    // =========================================================
    // INITIALISE DASHBOARD
    // =========================================================

    document.addEventListener("DOMContentLoaded", function () {

        initRecruitmentControls();
        initMultiCheckDropdowns();
        updateGenomicFilterStatus();

        // 1. PATIENT & METADATA
        createDonutChart("patientsBySexChart", patientsBySex);
        createBarChart("patientsByAgeGroupChart", patientsByAgeGroup, {
            yAxisTitle: "Accepted Patients (n)"
        });
        createDonutChart("militaryCivilianChart", militaryCivilian);
        createDonutChart("patientTypeChart", patientType);
        createDonutChart("haiCaiChart", haiCai);
        createBarChart("clinicalPresentationChart", clinicalPresentation, {
            horizontal: true,
            sortDescending: true,
            xAxisTitle: "Accepted Patients (n)"
        });

        // 2. ISOLATE INFORMATION & AST
        createBarChart("organismDistributionChart", isolatesByOrganism, {
            horizontal: true,
            sortDescending: true,
            xAxisTitle: "Accepted Isolates (n)"
        });
        createDonutChart("cultureResultsChart", cultureResults);

        createAntibiogram();
        initResistanceTrends();

        const antibiogramSearchInput = document.getElementById("antibiogramSearchInput");
        const antibiogramSortSelect = document.getElementById("antibiogramSortSelect");

        if (antibiogramSearchInput) {
            antibiogramSearchInput.addEventListener("input", createAntibiogram);
        }
        if (antibiogramSortSelect) {
            antibiogramSortSelect.addEventListener("change", createAntibiogram);
        }

        // 3. GENOMICS
        createLineChart("sequencingOverTimeChart", sequencingOverTime);
        createBarChart("genomeCompletenessChart", genomeCompleteness, {
            yAxisTitle: "Genomes (n)",
            barColor: "#009E73"
        });
        createBarChart("strainTypesChart", strainTypes, {
            horizontal: true,
            sortDescending: true,
            xAxisTitle: "Genomes (n)"
        });
        createBarChart("genePrevalenceChart", genePrevalence, {
            horizontal: true,
            sortDescending: true,
            xAxisTitle: "Genomes Carrying Gene (n)"
        });
        createBarChart("genomicScoresChart", genomicScores, {
            yAxisTitle: "Score / Count",
            showPercent: false
        });

        // Resize Plotly charts when Bootstrap tabs change
        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
            tab.addEventListener("shown.bs.tab", function () {
                setTimeout(resizeVisibleCharts, 100);
            });
        });
    });

</script>


