                                                </td>
                                                <td class="text-end fw-semibold">@item.Tested.ToString("N0")</td>
                                                <td class="text-end">
                                                    <span class="sir-badge sir-badge-s">
                                                        @item.Susceptible.ToString("N0") (@item.SusceptiblePercentage.ToString("F1")%)
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <span class="sir-badge sir-badge-i">
                                                        @item.Intermediate.ToString("N0") (@item.IntermediatePercentage.ToString("F1")%)
                                                    </span>
                                                </td>
