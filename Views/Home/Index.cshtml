                            <p>
                                No accepted isolates matching the current filters have usable AST results for the selected organism(s).
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="ast-summary">
                            <span class="ast-count-badge">
                                <i class="bi bi-virus2"></i>
                                @Model.ASTOrganismDisplayTitle — @Model.ASTOrganismIsolateCount.ToString("N0") accepted isolate(s)
                            </span>

                            @if (Model.UseAntibiogram)
                            {
                                <span class="ast-method-badge">
                                    <i class="bi bi-bar-chart-steps"></i>
                                    Cumulative Antibiogram (n &ge; 30)
                                </span>
                            }
                            else
                            {
                                <span class="ast-method-badge">
                                    <i class="bi bi-grid-3x3-gap"></i>
                                    Small-sample AST summary (n &lt; 30 — interpret with caution)
                                </span>
                            }

                            @if (Model.IsMultiOrganismAST)
                            {
                                <span class="ast-pooled-badge" title="Multiple species are combined; interpret drugs affected by intrinsic resistance carefully">
