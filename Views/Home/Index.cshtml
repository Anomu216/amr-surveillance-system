    // =========================================================
    // COMMON HELPERS
    // =========================================================

    function getLabels(data) {
        return Array.isArray(data)
            ? data.map(item => item.label ?? "Unspecified")
            : [];
    }

    function getValues(data) {
        return Array.isArray(data)
            ? data.map(item => Number(item.value) || 0)
            : [];
    }

    function hasData(data) {
        return Array.isArray(data) &&
            data.length > 0 &&
            data.some(item => Number(item.value) > 0);
    }

    function formatCountAndPercent(value, total) {
        if (!total || total <= 0) {
            return value.toLocaleString();
        }
        const pct = ((value / total) * 100).toFixed(1);
        return `${value.toLocaleString()} (${pct}%)`;
    }

    function getPublicationLayout() {
        return {
            margin: { l: 60, r: 30, t: 24, b: 60 },
            paper_bgcolor: "#ffffff",
            plot_bgcolor: "#ffffff",
            font: {
                family: "Inter, 'Segoe UI', Arial, sans-serif",
                size: 12,
                color: "#1e293b"
            },
            hoverlabel: {
                bgcolor: "#ffffff",
                bordercolor: "#cbd5e1",
                font: {
                    family: "Inter, 'Segoe UI', Arial, sans-serif",
                    size: 12,
                    color: "#0f172a"
                }
            }
        };
    }

    function showNoData(elementId, customMessage) {
        const element = document.getElementById(elementId);
        if (!element) return;

        Plotly.newPlot(
            elementId,
            [],
            {
                ...getPublicationLayout(),
                annotations: [{
                    text: customMessage || "No accepted sample records available for this view",
                    showarrow: false,
                    font: { size: 13.5, color: "#64748b" }
                }],
                xaxis: { visible: false },
                yaxis: { visible: false }
            },
            { responsive: true, displayModeBar: false }
        );
    }


    // =========================================================
    // PUBLICATION-QUALITY PNG EXPORT
    // =========================================================

    async function downloadChart(elementId, fileName) {
        const chart = document.getElementById(elementId);
        if (!chart || !chart.data || chart.data.length === 0) return;

        const card = chart.closest(".chart-card, .ast-trends-section, .ast-analysis-card");
        const titleEl = card ? card.querySelector("h3, h4") : null;
        const subtitleEl = card ? card.querySelector(".chart-header p, .ast-trends-header p, .ast-header p") : null;

        const titleText = titleEl ? titleEl.textContent.trim() : fileName;
        const subtitleText = subtitleEl ? subtitleEl.textContent.trim() : "";

        const originalTitle = chart.layout.title;
        const originalMargin = { ...chart.layout.margin };
        const originalAnnotations = [...(chart.layout.annotations || [])];

        const exportAnnotations = [
            ...originalAnnotations,
            {
                text: "Source: AMR Surveillance System • Accepted Samples Only",
                xref: "paper",
                yref: "paper",
                x: 0,
                y: -0.18,
                xanchor: "left",
                yanchor: "top",
                showarrow: false,
                font: { size: 11, color: "#64748b" }
            }
        ];

        await Plotly.relayout(chart, {
            title: {
                text: subtitleText
                    ? `<b>${titleText}</b><br><span style="font-size:12px;color:#475569">${subtitleText}</span>`
                    : `<b>${titleText}</b>`,
                x: 0.02,
                xanchor: "left",
                font: { size: 16, color: "#0f172a" }
            },
            margin: {
                ...originalMargin,
                t: Math.max((originalMargin.t || 24) + 52, 76),
                b: Math.max((originalMargin.b || 60) + 28, 88)
            },
            annotations: exportAnnotations
        });

        await Plotly.downloadImage(chart, {
            format: "png",
            filename: `${fileName}-accepted`,
            width: 1800,
            height: 1100,
            scale: 3
        });

        await Plotly.relayout(chart, {
            title: originalTitle || null,
            margin: originalMargin,
            annotations: originalAnnotations
        });
    }


