@model AMRSurveillance.ViewModels.DashboardViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";

    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    var genomicFilterCount = new[]
    {
        Model.GenomicCharacteristic,
        Model.GenomicCharacteristicValue,
        Model.StrainType,
        Model.Phylogroup,
        Model.Serotype,
        Model.SCCmecType,
        Model.SpaType,
        Model.OLocus,
        Model.KLocus
    }
    .Count(value => !string.IsNullOrWhiteSpace(value));

    var activeGlobalFilterCount =
        (Model.StartDate.HasValue ? 1 : 0) +
        (Model.EndDate.HasValue ? 1 : 0) +
        (!string.IsNullOrWhiteSpace(Model.RecruitmentType) ? 1 : 0) +
        (Model.IsGroupedByRecruitmentType ? 1 : 0) +
        (!string.IsNullOrWhiteSpace(Model.FacilityOwnership) ? 1 : 0) +
        Model.FacilityIDs.Count +
        Model.OrganismIDs.Count;

    var openAstTabOnLoad = Context.Request.Query.ContainsKey("ASTOrganismIDs");

    var totalSubmitted = Model.TotalSubmittedSamples;
    var acceptanceRate = totalSubmitted > 0 ? (Model.TotalPatients * 100.0 / totalSubmitted).ToString("F1") : "0.0";
    var rejectionRate = totalSubmitted > 0 ? (Model.RejectedSamples * 100.0 / totalSubmitted).ToString("F1") : "0.0";
    var positivityRate = Model.TotalIsolates > 0 ? (Model.PositiveCultures * 100.0 / Model.TotalIsolates).ToString("F1") : "0.0";
    var mdrRate = Model.TotalIsolates > 0 ? (Model.MDRIsolates * 100.0 / Model.TotalIsolates).ToString("F1") : "0.0";
    var wgsRate = Model.TotalIsolates > 0 ? (Model.SequencedIsolates * 100.0 / Model.TotalIsolates).ToString("F1") : "0.0";

    var selectedFacilitySet = new HashSet<string>(Model.FacilityIDs, StringComparer.OrdinalIgnoreCase);
    var selectedOrganismSet = new HashSet<string>(Model.OrganismIDs, StringComparer.OrdinalIgnoreCase);
    var selectedAstOrganismSet = new HashSet<string>(Model.ASTOrganismIDs, StringComparer.OrdinalIgnoreCase);
}

<div class="dashboard-page">

    <!-- ========================================================= -->
    <!-- DASHBOARD HEADER                                          -->
    <!-- ========================================================= -->

    <div class="dashboard-header">

        <div>
            <div class="dashboard-title-row">
                <h1 class="dashboard-title">
                    AMR Surveillance Dashboard
                </h1>
                <span class="accepted-scope-badge" title="All KPIs, charts, and antibiograms exclude rejected samples">
                    <i class="bi bi-patch-check-fill"></i>
                    Accepted Samples Only
                </span>
                @if (!string.IsNullOrWhiteSpace(Model.RecruitmentType))
                {
                    <span class="recruitment-scope-badge" title="Filtered by recruitment strategy">
                        <i class="bi bi-funnel-fill"></i>
                        @Model.RecruitmentScopeLabel
                    </span>
                }
                else if (Model.IsGroupedByRecruitmentType)
                {
                    <span class="recruitment-scope-badge" title="Stratified side-by-side comparison enabled">
                        <i class="bi bi-columns-gap"></i>
                        Grouped: Active vs. Passive
                    </span>
                }
            </div>

            <p class="dashboard-subtitle">
                Publication-ready epidemiological, microbiological, and genomic surveillance summaries
            </p>
        </div>

        <div class="dashboard-header-actions">

            <div class="data-updated">
                <i class="bi bi-clock-history"></i>
                <span>
                    Updated: @Model.DataUpdatedAt.ToString("dd MMM yyyy HH:mm") EAT
                </span>
            </div>

            <a asp-action="ExportExcel"
               asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
               asp-route-RecruitmentType="@Model.RecruitmentType"
               asp-route-GroupByRecruitmentType="@Model.GroupByRecruitmentType"
               asp-route-FacilityOwnership="@Model.FacilityOwnership"
               class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-excel"></i>
                <span>Export Excel</span>
            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ERROR MESSAGE                                             -->
    <!-- ========================================================= -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger dashboard-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @Model.ErrorMessage
        </div>
    }


    <!-- ========================================================= -->
    <!-- ROLLING 92-DAY DATA-DRIVEN SPIKE ALERTS                   -->
    <!-- ========================================================= -->
    @if (Model.HasDetectedSpikes)
    {
        <div class="alert alert-warning border-warning dashboard-alert shadow-sm mb-3" role="alert">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
                <div class="fw-bold text-dark">
                    <i class="bi bi-exclamation-diamond-fill text-danger me-1"></i>
                    Resistance Spike Alerts Detected (Rolling 92-Day Window vs. Historical Baseline, N &ge; 30)
                </div>
                <span class="badge rounded-pill text-bg-danger">
                    @Model.DetectedSpikes.Count Active @(Model.DetectedSpikes.Count == 1 ? "Alert" : "Alerts")
                </span>
            </div>
            <ul class="mb-0 ps-3 small text-dark">
                @foreach (var spike in Model.DetectedSpikes)
                {
                    <li class="mt-1">@spike.SummaryMessage</li>
                }
            </ul>
        </div>
    }


    <!-- ========================================================= -->
    <!-- COLLAPSIBLE GLOBAL FILTERS                                -->
    <!-- ========================================================= -->

    <div class="dashboard-card filters-card">

        <div class="filters-header">

            <div class="filters-title">

                <div class="filters-title-icon">
                    <i class="bi bi-funnel"></i>
                </div>

                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h2>Global Filters</h2>
                        @if (activeGlobalFilterCount > 0)
                        {
                            <span class="badge rounded-pill text-bg-primary">@activeGlobalFilterCount active</span>
                        }
                    </div>
                    <p>
                        Filter accepted surveillance records by enrollment dates, recruitment strategy, facility, and organism.
                    </p>
                </div>

            </div>

            <div class="d-flex align-items-center gap-2">
                @if (activeGlobalFilterCount > 0)
                {
                    <a asp-action="Index" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-x-circle me-1"></i>Clear All
                    </a>
                }
                <button class="btn btn-outline-secondary btn-sm"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#dashboardFilters"
                        aria-expanded="@(activeGlobalFilterCount > 0 ? "true" : "false")"
                        aria-controls="dashboardFilters">
                    <i class="bi bi-chevron-down me-1"></i>
                    <span>@(activeGlobalFilterCount > 0 ? "Filters" : "Show Filters")</span>
                </button>
            </div>

        </div>

        <div class="collapse @(activeGlobalFilterCount > 0 ? "show" : "")" id="dashboardFilters">

            <div class="filters-body">

                <form asp-action="Index" method="get">

                    <div class="row g-3">

                        <div class="col-12 col-sm-6 col-lg-2">
                            <label asp-for="StartDate" class="form-label">Start Date</label>
                            <input asp-for="StartDate" type="date" class="form-control form-control-sm" />
                        </div>

                        <div class="col-12 col-sm-6 col-lg-2">
                            <label asp-for="EndDate" class="form-label">End Date</label>
                            <input asp-for="EndDate" type="date" class="form-control form-control-sm" />
                        </div>

                        <div class="col-12 col-sm-6 col-lg-2">
                            <label asp-for="RecruitmentType" class="form-label">Recruitment</label>
                            <select asp-for="RecruitmentType" id="recruitmentTypeSelect" class="form-select form-select-sm">
                                <option value="">All (Overall)</option>
                                @foreach (var option in Model.RecruitmentTypeOptions)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-2">
                            <label asp-for="FacilityOwnership" class="form-label">Ownership</label>
                            <select asp-for="FacilityOwnership" class="form-select form-select-sm">
                                <option value="">All ownership types</option>
                                @foreach (var option in Model.FacilityOwnershipOptions)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                        </div>

                        <!-- Multi-select Checkbox Dropdown: Facilities -->
                        <div class="col-12 col-sm-6 col-lg-2">
                            <label class="form-label">Facilities</label>
                            <div class="dropdown multi-check-dropdown" data-placeholder="All facilities" data-item-label="facility" data-items-label="facilities">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start d-flex justify-content-between align-items-center multi-check-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        aria-expanded="false">
                                    <span class="multi-check-summary text-truncate">All facilities</span>
                                </button>
                                <div class="dropdown-menu w-100 p-2 shadow-sm multi-check-menu">
                                    <input type="text"
                                           class="form-control form-control-sm mb-2 multi-check-search"
                                           placeholder="Search facilities..."
                                           autocomplete="off" />
                                    <div class="d-flex justify-content-between align-items-center mb-1 pb-1 border-bottom small">
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none multi-check-all">Select all</button>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-danger multi-check-clear">Clear</button>
                                    </div>
                                    <div class="multi-check-list">
                                        @foreach (var facility in Model.Facilities)
                                        {
                                            var isChecked = selectedFacilitySet.Contains(facility.Value);
                                            var checkId = $"fac_{facility.Value}";
                                            <div class="form-check multi-check-item" data-search-text="@facility.Text.ToLowerInvariant()">
                                                <input class="form-check-input multi-check-input"
                                                       type="checkbox"
                                                       name="FacilityIDs"
                                                       value="@facility.Value"
                                                       id="@checkId"
                                                       checked="@isChecked" />
                                                <label class="form-check-label small" for="@checkId">
                                                    @facility.Text
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Multi-select Checkbox Dropdown: Global Organisms -->
                        <div class="col-12 col-sm-6 col-lg-2">
                            <label class="form-label">Organisms</label>
                            <div class="dropdown multi-check-dropdown" data-placeholder="All organisms" data-item-label="organism" data-items-label="organisms">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start d-flex justify-content-between align-items-center multi-check-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        aria-expanded="false">
                                    <span class="multi-check-summary text-truncate">All organisms</span>
                                </button>
                                <div class="dropdown-menu w-100 p-2 shadow-sm multi-check-menu">
                                    <input type="text"
                                           class="form-control form-control-sm mb-2 multi-check-search"
                                           placeholder="Search organisms..."
                                           autocomplete="off" />
                                    <div class="d-flex justify-content-between align-items-center mb-1 pb-1 border-bottom small">
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none multi-check-all">Select all</button>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-danger multi-check-clear">Clear</button>
                                    </div>
                                    <div class="multi-check-list">
                                        @foreach (var organism in Model.Organisms)
                                        {
                                            var isChecked = selectedOrganismSet.Contains(organism.Value);
                                            var checkId = $"org_{organism.Value}";
                                            <div class="form-check multi-check-item" data-search-text="@organism.Text.ToLowerInvariant()">
                                                <input class="form-check-input multi-check-input"
                                                       type="checkbox"
                                                       name="OrganismIDs"
                                                       value="@organism.Value"
                                                       id="@checkId"
                                                       checked="@isChecked" />
                                                <label class="form-check-label small" for="@checkId">
                                                    @organism.Text
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <div class="filter-actions">
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        <i class="bi bi-funnel-fill me-1"></i>
                                        Apply Filters
                                    </button>
                                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                                        Reset
                                    </a>
                                </div>

                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           asp-for="GroupByRecruitmentType"
                                           id="groupByRecruitmentSwitch"
                                           disabled="@(!string.IsNullOrWhiteSpace(Model.RecruitmentType))" />
                                    <label class="form-check-label small fw-semibold text-secondary" for="groupByRecruitmentSwitch">
                                        Group by Active vs. Passive (ISO)
                                    </label>
                                </div>
                            </div>
                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- COMPACT KPI STRIP                                         -->
    <!-- ========================================================= -->

    <div class="kpi-grid @(Model.ShowMRSAKpi ? "kpi-grid-7" : "")">

        <div class="kpi-card kpi-card-accepted">
            <div class="kpi-icon kpi-patients">
                <i class="bi bi-people"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Accepted Samples</div>
                <div class="kpi-value">@Model.TotalPatients.ToString("N0")</div>
                <div class="kpi-subtext">@acceptanceRate% of @totalSubmitted.ToString("N0") submitted</div>
            </div>
        </div>

        <div class="kpi-card kpi-card-rejected">
            <div class="kpi-icon kpi-rejected">
                <i class="bi bi-x-octagon"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Rejected Samples</div>
                <div class="kpi-value">@Model.RejectedSamples.ToString("N0")</div>
                <div class="kpi-subtext">@rejectionRate% excluded</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon kpi-isolates">
                <i class="bi bi-virus"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Total Isolates</div>
                <div class="kpi-value">@Model.TotalIsolates.ToString("N0")</div>
                <div class="kpi-subtext">Accepted cohort</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon kpi-positive">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Positive Cultures</div>
                <div class="kpi-value">@Model.PositiveCultures.ToString("N0")</div>
                <div class="kpi-subtext">@positivityRate% positivity</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon kpi-mdr">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">MDR Isolates</div>
                <div class="kpi-value">@Model.MDRIsolates.ToString("N0")</div>
                <div class="kpi-subtext">@mdrRate% of isolates</div>
            </div>
        </div>

        @if (Model.ShowMRSAKpi)
        {
            <div class="kpi-card kpi-card-mrsa">
                <div class="kpi-icon kpi-mrsa">
                    <i class="bi bi-virus2"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-label">MRSA (S. aureus)</div>
                    <div class="kpi-value">@Model.MRSAIsolates.ToString("N0")</div>
                    <div class="kpi-subtext">@Model.MRSAPercentage.ToString("F1")% of @Model.MRSADenominator.ToString("N0") tested</div>
                </div>
            </div>
        }

        <div class="kpi-card">
            <div class="kpi-icon kpi-genomics">
                <i class="bi bi-diagram-3"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Sequenced</div>
                <div class="kpi-value">@Model.SequencedIsolates.ToString("N0")</div>
                <div class="kpi-subtext">@wgsRate% WGS linked</div>
            </div>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- OPT-IN STRATIFIED RECRUITMENT COMPARISON (ACTIVE VS PASSIVE) -->
    <!-- ========================================================= -->
    @if (Model.IsGroupedByRecruitmentType && Model.RecruitmentStratifiedKpis.Count > 0)
    {
        <div class="dashboard-card p-3 mb-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <div>
                    <h3 class="h6 fw-bold text-dark mb-0">
                        <i class="bi bi-columns-gap text-primary me-1"></i>
                        Stratified Surveillance Summary: Active vs. Passive (ISO)
                    </h3>
                    <span class="small text-muted">
                        Side-by-side breakdown across recruitment strategies for the active filter cohort
                    </span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Recruitment Strategy</th>
                            <th class="text-end">Accepted Samples</th>
                            <th class="text-end">Rejected Samples</th>
                            <th class="text-end">Total Isolates</th>
                            <th class="text-end">Positive Cultures</th>
                            <th class="text-end">MDR Isolates</th>
                            @if (Model.ShowMRSAKpi)
                            {
                                <th class="text-end">MRSA (S. aureus)</th>
                            }
                            <th class="text-end">WGS Sequenced</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grp in Model.RecruitmentStratifiedKpis)
                        {
                            var grpSubmitted = grp.TotalPatients + grp.RejectedSamples;
                            var grpAccRate = grpSubmitted > 0 ? (grp.TotalPatients * 100.0 / grpSubmitted).ToString("F1") : "0.0";
                            var grpPosRate = grp.TotalIsolates > 0 ? (grp.PositiveCultures * 100.0 / grp.TotalIsolates).ToString("F1") : "0.0";
                            var grpMdrRate = grp.TotalIsolates > 0 ? (grp.MDRIsolates * 100.0 / grp.TotalIsolates).ToString("F1") : "0.0";
                            var grpWgsRate = grp.TotalIsolates > 0 ? (grp.SequencedIsolates * 100.0 / grp.TotalIsolates).ToString("F1") : "0.0";
                            var isPassive = string.Equals(grp.RecruitmentType, "Passive", StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <td class="fw-semibold">
                                    <span class="badge @(isPassive ? "text-bg-secondary" : "text-bg-primary") me-1">
                                        @(isPassive ? "Passive (ISO)" : "Active")
                                    </span>
                                </td>
                                <td class="text-end fw-semibold">
                                    @grp.TotalPatients.ToString("N0")
                                    <span class="text-muted">(@grpAccRate%)</span>
                                </td>
                                <td class="text-end text-danger">
                                    @grp.RejectedSamples.ToString("N0")
                                </td>
                                <td class="text-end fw-semibold">
                                    @grp.TotalIsolates.ToString("N0")
                                </td>
                                <td class="text-end">
                                    @grp.PositiveCultures.ToString("N0")
                                    <span class="text-muted">(@grpPosRate%)</span>
                                </td>
                                <td class="text-end">
                                    @grp.MDRIsolates.ToString("N0")
                                    <span class="text-muted">(@grpMdrRate%)</span>
                                </td>
                                @if (Model.ShowMRSAKpi)
                                {
                                    <td class="text-end">
                                        @grp.MRSAIsolates.ToString("N0")
                                        <span class="text-muted">(@grp.MRSAPercentage.ToString("F1")%)</span>
                                    </td>
                                }
                                <td class="text-end">
                                    @grp.SequencedIsolates.ToString("N0")
                                    <span class="text-muted">(@grpWgsRate%)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }


    <!-- ========================================================= -->
    <!-- ANALYTICAL TABS                                           -->
    <!-- ========================================================= -->

    <div class="dashboard-tabs-wrapper">

        <ul class="nav nav-tabs dashboard-tabs" id="dashboardTabs" role="tablist">

            <li class="nav-item" role="presentation">
                <button class="nav-link @(openAstTabOnLoad ? "" : "active")"
                        id="patient-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#patient-panel"
                        type="button"
                        role="tab">
                    <i class="bi bi-person-vcard"></i>
                    Patient &amp; Metadata
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link @(openAstTabOnLoad ? "active" : "")"
                        id="isolate-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#isolate-panel"
                        type="button"
                        role="tab">
                    <i class="bi bi-virus2"></i>
                    Isolate Information &amp; AST
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        id="genomics-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#genomics-panel"
                        type="button"
                        role="tab">
                    <i class="bi bi-diagram-3"></i>
                    Genomics
                </button>
            </li>

        </ul>


        <div class="tab-content dashboard-tab-content">


            <!-- ================================================= -->
            <!-- PATIENT & METADATA                                -->
            <!-- ================================================= -->

            <div class="tab-pane fade @(openAstTabOnLoad ? "" : "show active")" id="patient-panel" role="tabpanel">

                <div class="section-intro">
                    <div>
                        <h2>Patient &amp; Metadata</h2>
                        <p>
                            Demographic and clinical distribution among accepted surveillance patients (n = @Model.TotalPatients.ToString("N0")).
                        </p>
                    </div>
                </div>

                <div class="chart-grid">

                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Sex Distribution</h3>
                            <p>Accepted patients stratified by biological sex</p>
                        </div>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-outline-secondary"
                                    title="Download publication PNG"
                                    onclick="downloadChart('patientsBySexChart', 'sex-distribution')">
                                <i class="bi bi-download"></i>
                            </button>
                        </div>
                        <div id="patientsBySexChart" class="plotly-chart chart-pie"></div>
                    </div>

                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Age Group Distribution</h3>
                            <p>Accepted patient counts and share across age brackets</p>
                        </div>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-outline-secondary"
                                    title="Download publication PNG"
                                    onclick="downloadChart('patientsByAgeGroupChart', 'age-groups')">
                                <i class="bi bi-download"></i>
                            </button>
                        </div>
                        <div id="patientsByAgeGroupChart" class="plotly-chart"></div>
                    </div>

                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Military / Civilian Status</h3>
                            <p>Population classification among accepted patients</p>
                        </div>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-outline-secondary"
                                    title="Download publication PNG"
                                    onclick="downloadChart('militaryCivilianChart', 'military-civilian-status')">
                                <i class="bi bi-download"></i>
                            </button>
                        </div>
                        <div id="militaryCivilianChart" class="plotly-chart chart-pie"></div>
                    </div>

                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Patient Care Setting</h3>
                            <p>Inpatient vs. outpatient distribution (accepted cohort)</p>
                        </div>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-outline-secondary"
                                    title="Download publication PNG"
                                    onclick="downloadChart('patientTypeChart', 'patient-type')">
                                <i class="bi bi-download"></i>
                            </button>
                        </div>
                        <div id="patientTypeChart" class="plotly-chart chart-pie"></div>
                    </div>

                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Infection Acquisition (HAI / CAI)</h3>
                            <p>Healthcare-associated vs. community-associated infections</p>
                        </div>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-outline-secondary"
                                    title="Download publication PNG"
                                    onclick="downloadChart('haiCaiChart', 'hai-cai-classification')">
                                <i class="bi bi-download"></i>
                            </button>
                        </div>
                        <div id="haiCaiChart" class="plotly-chart chart-pie"></div>
                    </div>

                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Clinical Presentation</h3>
                            <p>Ranked clinical syndromes at enrollment (accepted patients)</p>
                        </div>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-outline-secondary"
                                    title="Download publication PNG"
                                    onclick="downloadChart('clinicalPresentationChart', 'clinical-presentation')">
                                <i class="bi bi-download"></i>
                            </button>
                        </div>
                        <div id="clinicalPresentationChart" class="plotly-chart chart-large"></div>
                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ISOLATE INFORMATION & AST                         -->
            <!-- ================================================= -->

            <div class="tab-pane fade @(openAstTabOnLoad ? "show active" : "")" id="isolate-panel" role="tabpanel">

                <div class="section-intro">
                    <div>
                        <h2>Isolate Information &amp; AST</h2>
                        <p>
                            Microbiological recovery, cumulative antibiograms, and temporal resistance trajectories for accepted samples.
                        </p>
                    </div>
                </div>

                <div class="chart-grid">

                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Organism Distribution</h3>
                            <p>Ranked frequency of recovered bacterial species</p>
                        </div>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-outline-secondary"
                                    title="Download publication PNG"
                                    onclick="downloadChart('organismDistributionChart', 'organism-distribution')">
                                <i class="bi bi-download"></i>
                            </button>
                        </div>
                        <div id="organismDistributionChart" class="plotly-chart chart-large"></div>
                    </div>

                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Culture Outcomes</h3>
                            <p>Proportion of positive, negative, and contaminated cultures</p>
                        </div>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-outline-secondary"
                                    title="Download publication PNG"
                                    onclick="downloadChart('cultureResultsChart', 'culture-results')">
                                <i class="bi bi-download"></i>
                            </button>
                        </div>
                        <div id="cultureResultsChart" class="plotly-chart chart-pie"></div>
                    </div>

                </div>

                <!-- AST ANALYSIS & LONGITUDINAL RESISTANCE TRENDS -->

                <div class="dashboard-card ast-analysis-card">

                    <div class="ast-header">
                        <div>
                            <h3>Cumulative Antibiogram &amp; AST Profile</h3>
                            <p>
                                Select one or more target organisms to inspect pooled S / I / R distributions and longitudinal resistance trends across tested antimicrobial agents (accepted samples only).
                            </p>
                        </div>
                    </div>

                    <form asp-action="Index" method="get" class="ast-filter-form">

                        <input type="hidden" asp-for="StartDate" />
                        <input type="hidden" asp-for="EndDate" />
                        <input type="hidden" asp-for="RecruitmentType" />
                        <input type="hidden" asp-for="GroupByRecruitmentType" />
                        <input type="hidden" asp-for="FacilityOwnership" />

                        @foreach (var facilityId in Model.FacilityIDs)
                        {
                            <input type="hidden" name="FacilityIDs" value="@facilityId" />
                        }

                        @foreach (var organismId in Model.OrganismIDs)
                        {
                            <input type="hidden" name="OrganismIDs" value="@organismId" />
                        }

                        <div class="row g-3 align-items-end">

                            <div class="col-12 col-md-8 col-lg-6">
                                <label class="form-label">
                                    Organism(s) for AST Analysis
                                </label>
                                <div class="dropdown multi-check-dropdown" data-placeholder="Select one or more organisms" data-item-label="organism" data-items-label="organisms">
                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start d-flex justify-content-between align-items-center multi-check-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            data-bs-auto-close="outside"
                                            aria-expanded="false">
                                        <span class="multi-check-summary text-truncate">Select one or more organisms</span>
                                    </button>
                                    <div class="dropdown-menu w-100 p-2 shadow-sm multi-check-menu">
                                        <input type="text"
                                               class="form-control form-control-sm mb-2 multi-check-search"
                                               placeholder="Search organisms..."
                                               autocomplete="off" />
                                        <div class="d-flex justify-content-between align-items-center mb-1 pb-1 border-bottom small">
                                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none multi-check-all">Select all</button>
                                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-danger multi-check-clear">Clear</button>
                                        </div>
                                        <div class="multi-check-list">
                                            @foreach (var organism in Model.Organisms)
                                            {
                                                var isChecked = selectedAstOrganismSet.Contains(organism.Value);
                                                var checkId = $"ast_org_{organism.Value}";
                                                <div class="form-check multi-check-item" data-search-text="@organism.Text.ToLowerInvariant()">
                                                    <input class="form-check-input multi-check-input"
                                                           type="checkbox"
                                                           name="ASTOrganismIDs"
                                                           value="@organism.Value"
                                                           id="@checkId"
                                                           checked="@isChecked" />
