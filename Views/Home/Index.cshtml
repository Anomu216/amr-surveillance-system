    // =========================================================
    // ANTIBIOGRAM (Interactive Sort/Filter + Stacked Bar + Table)
    // =========================================================

    function getFilteredAndSortedAntibiogram() {
        if (!Array.isArray(antibiogram)) return [];

        const searchInput = document.getElementById("antibiogramSearchInput");
        const sortSelect = document.getElementById("antibiogramSortSelect");

        const term = searchInput ? searchInput.value.trim().toLowerCase() : "";
        const sortMode = sortSelect ? sortSelect.value : "default";

        let rows = antibiogram.filter(item => {
            if (!term) return true;
            const name = (item.antibioticName || "").toLowerCase();
            const code = (item.antibioticCode || "").toLowerCase();
            return name.includes(term) || code.includes(term);
        });

        if (sortMode === "resistant-desc") {
            rows.sort((a, b) => (Number(b.resistantPercentage) || 0) - (Number(a.resistantPercentage) || 0));
        } else if (sortMode === "susceptible-desc") {
            rows.sort((a, b) => (Number(b.susceptiblePercentage) || 0) - (Number(a.susceptiblePercentage) || 0));
        } else if (sortMode === "tested-desc") {
            rows.sort((a, b) => (Number(b.tested) || 0) - (Number(a.tested) || 0));
        } else if (sortMode === "alpha-asc") {
            rows.sort((a, b) => (a.antibioticName || "").localeCompare(b.antibioticName || ""));
        }

        return rows;
    }

    function renderAntibiogramTable(rows) {
        const tbody = document.getElementById("antibiogramTableBody");
        if (!tbody) return;

        tbody.innerHTML = rows.map(item => {
            const name = item.antibioticName ?? "Unknown";
            const code = item.antibioticCode ?? "";
            const tested = (Number(item.tested) || 0).toLocaleString();
            const sCount = (Number(item.susceptible) || 0).toLocaleString();
            const sPct = (Number(item.susceptiblePercentage) || 0).toFixed(1);
            const iCount = (Number(item.intermediate) || 0).toLocaleString();
            const iPct = (Number(item.intermediatePercentage) || 0).toFixed(1);
            const rCount = (Number(item.resistant) || 0).toLocaleString();
            const rPct = (Number(item.resistantPercentage) || 0).toFixed(1);

            return `
                <tr>
                    <td class="abx-cell-name">
                        ${name}
                        ${code ? `<span class="abx-code-tag">${code}</span>` : ""}
                    </td>
                    <td class="text-end fw-semibold">${tested}</td>
                    <td class="text-end"><span class="sir-badge sir-badge-s">${sCount} (${sPct}%)</span></td>
