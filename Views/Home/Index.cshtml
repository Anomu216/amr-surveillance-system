                                                        @organism.Text
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-auto">
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="bi bi-search me-1"></i>
                                    Analyse AST
                                </button>
                            </div>

                        </div>

                    </form>

                    @if (!Model.HasASTOrganismSelection)
                    {
