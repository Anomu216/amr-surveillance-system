@model List<AMRSurveillance.Models.DataRequest>

@{
    ViewData["Title"] = "My Data Requests";
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- PAGE HEADER                                               -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-clock-history me-2"></i>
                My Data Requests
            </h2>

            <p class="text-muted mb-0">
                View the status of your submitted data requests and
                download approved exports.
            </p>
        </div>

        <a asp-controller="DataRequest"
           asp-action="Index"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            New Data Request
        </a>

    </div>


    <!-- ========================================================= -->
    <!-- SUCCESS & ERROR MESSAGES                                  -->
    <!-- ========================================================= -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>
            @errorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }


    <!-- ========================================================= -->
    <!-- REQUEST HISTORY                                           -->
    <!-- ========================================================= -->

    <div class="card shadow-sm">

        <div class="card-header bg-white d-flex
                    justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>
                Request History
            </h5>

            <span class="badge bg-secondary">
                @Model.Count Request@(Model.Count == 1 ? "" : "s")
            </span>

        </div>


        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Request #</th>
                                <th>Reason</th>
                                <th>Requested</th>
                                <th>Status</th>
                                <th>Reviewed</th>
                                <th>Review Comments</th>
                                <th class="text-center">Export</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var request in Model)
                            {
                                var effectiveStatus = request.IsExpired
                                ? "Expired"
                                : string.IsNullOrWhiteSpace(request.Status)
                                ? "Pending"
                                : request.Status.Trim();

                                var statusClass =
                                effectiveStatus.Equals("Approved", StringComparison.OrdinalIgnoreCase)
                                ? "bg-success"
                                : effectiveStatus.Equals("Expired", StringComparison.OrdinalIgnoreCase)
                                ? "bg-secondary"
                                : effectiveStatus.Equals("Rejected", StringComparison.OrdinalIgnoreCase)
                                ? "bg-danger"
                                : "bg-warning text-dark";

                                var expiresAtIso = request.ExpiresAt.HasValue
                                ? $"{request.ExpiresAt.Value:yyyy-MM-ddTHH:mm:ss}+03:00"
                                : string.Empty;

                                <tr data-request-row="@request.DataRequestID">

                                    <!-- REQUEST ID -->
                                    <td>
                                        <strong>
                                            #@request.DataRequestID
                                        </strong>
                                    </td>


                                    <!-- REASON -->
                                    <td style="max-width: 300px;">

                                        @if (!string.IsNullOrWhiteSpace(request.Reason)
                                                                        && request.Reason.Length > 100)
                                        {
                                            <span title="@request.Reason">
                                                @(request.Reason.Substring(0, 100) + "...")
                                            </span>
                                        }
                                        else
                                        {
                                            @request.Reason
                                        }

                                    </td>


                                    <!-- REQUEST DATE (Already stored in EAT) -->
                                    <td class="text-nowrap">
                                        @request.RequestedAt.ToString("dd MMM yyyy HH:mm") EAT
                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        <span class="badge @statusClass js-status-badge">
                                            @effectiveStatus
                                        </span>

                                    </td>


                                    <!-- REVIEW DATE (Already stored in EAT) -->
                                    <td class="text-nowrap">

                                        @if (request.ReviewedAt.HasValue)
                                        {
                                            <span>@request.ReviewedAt.Value.ToString("dd MMM yyyy HH:mm") EAT</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- REVIEW COMMENTS -->
                                    <td style="max-width: 250px;">

                                        @if (!string.IsNullOrWhiteSpace(request.ReviewComments))
                                        {
                                            @request.ReviewComments
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- EXPORT -->
                                    <td class="text-center js-export-cell">

                                        @if (effectiveStatus.Equals("Approved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="d-inline-flex flex-column align-items-center gap-1">
                                                <a asp-controller="DataRequest"
                                                   asp-action="Download"
                                                   asp-route-id="@request.DataRequestID"
                                                   class="btn btn-sm btn-success js-download-btn"
                                                   data-request-id="@request.DataRequestID"
                                                   data-expires-at="@expiresAtIso"
                                                   title="Download approved data export">

                                                    <i class="bi bi-download me-1"></i>
                                                    Download

                                                </a>

                                                <small class="text-muted js-countdown-text @(request.ExpiresAt.HasValue ? "" : "d-none")"
                                                       data-expires-at="@expiresAtIso">
                                                </small>
                                            </div>
                                        }
                                        else if (effectiveStatus.Equals("Expired", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="d-inline-flex flex-column align-items-center gap-1">
                                                <span class="text-muted small">
                                                    <i class="bi bi-clock-history me-1"></i>
                                                    Download window elapsed
                                                </span>
                                                <a asp-controller="DataRequest"
                                                   asp-action="Index"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-arrow-repeat me-1"></i>
                                                    Request Afresh
                                                </a>
                                            </div>
                                        }
                                        else if (effectiveStatus.Equals("Rejected", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="text-danger small">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Not approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                <i class="bi bi-hourglass-split me-1"></i>
                                                Awaiting approval
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- ================================================= -->
                <!-- EMPTY STATE                                       -->
                <!-- ================================================= -->

                <div class="text-center py-5">

                    <i class="bi bi-file-earmark-text text-muted"
                       style="font-size: 3rem;">
                    </i>

                    <h5 class="mt-3">
                        No Data Requests Yet
                    </h5>

                    <p class="text-muted mb-3">
                        You have not submitted any data requests.
                    </p>

                    <a asp-controller="DataRequest"
                       asp-action="Index"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Create Your First Request

                    </a>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts {
    <script>
        (function () {
            const SEVENTY_TWO_HOURS_MS = 72 * 60 * 60 * 1000;
            const requestIndexUrl = '@Url.Action("Index", "DataRequest")';

            function formatRemaining(ms) {
                const totalSeconds = Math.max(0, Math.floor(ms / 1000));
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                const seconds = totalSeconds % 60;

                return `${hours}h ${String(minutes).padStart(2, '0')}m ${String(seconds).padStart(2, '0')}s`;
            }

            function markRowExpired(row) {
                if (!row) return;

                const badge = row.querySelector('.js-status-badge');
                if (badge) {
                    badge.textContent = 'Expired';
                    badge.classList.remove('bg-success', 'bg-warning', 'text-dark', 'bg-danger');
                    badge.classList.add('bg-secondary');
                }

                const exportCell = row.querySelector('.js-export-cell');
                if (exportCell) {
                    exportCell.innerHTML = `
                        <div class="d-inline-flex flex-column align-items-center gap-1">
                            <span class="text-muted small">
                                <i class="bi bi-clock-history me-1"></i>
                                Download window elapsed
                            </span>
                            <a href="${requestIndexUrl}" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-repeat me-1"></i>
                                Request Afresh
                            </a>
                        </div>`;
                }
            }

            function startCountdown(countdownEl, expiresAtMs, prefixText) {
                if (countdownEl.dataset.timerRunning === 'true') return;
                countdownEl.dataset.timerRunning = 'true';
                countdownEl.classList.remove('d-none');

                const row = countdownEl.closest('tr');

                function tick() {
                    const remaining = expiresAtMs - Date.now();
                    if (remaining <= 0) {
                        clearInterval(intervalId);
                        markRowExpired(row);
                        return;
                    }

                    countdownEl.innerHTML = `<i class="bi bi-hourglass-split me-1"></i>${prefixText} <strong>${formatRemaining(remaining)}</strong>`;
                }

                tick();
                const intervalId = setInterval(tick, 1000);
            }

            // Resume active countdowns on page load for already-downloaded requests
            document.querySelectorAll('.js-countdown-text').forEach(el => {
                const iso = el.dataset.expiresAt;
                if (!iso) return;

                const expiresAtMs = Date.parse(iso);
                if (!Number.isNaN(expiresAtMs)) {
                    startCountdown(el, expiresAtMs, 'Expires in');
                }
            });

            // Immediately display notice & start 72-hour countdown on first download click
            document.querySelectorAll('.js-download-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const container = btn.parentElement;
                    const countdownEl = container?.querySelector('.js-countdown-text');
                    if (!countdownEl) return;

                    // Anchor strictly to the first download; re-clicks do not reset the timer
                    if (!btn.dataset.expiresAt) {
                        const expiresAtMs = Date.now() + SEVENTY_TWO_HOURS_MS;
                        const iso = new Date(expiresAtMs).toISOString();
                        btn.dataset.expiresAt = iso;
                        countdownEl.dataset.expiresAt = iso;
                        startCountdown(countdownEl, expiresAtMs, 'Download expires in');
                    }
                });
            });
        })();
    </script>
}