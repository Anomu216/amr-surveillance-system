@using System.Text.Json
@model AMRSurveillance.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Surveillance Reports";
    var chartLabelsJson = JsonSerializer.Serialize(Model.SixPeriodRollup.Select(p => p.PeriodLabel));
    var gnMdrSeriesJson = JsonSerializer.Serialize(Model.SixPeriodRollup.Select(p => p.GnMDRRate));
    var mrsaSeriesJson = JsonSerializer.Serialize(Model.SixPeriodRollup.Select(p => p.MRSARate));
    var creSeriesJson = JsonSerializer.Serialize(Model.SixPeriodRollup.Select(p => p.CRERate));
    var esblSeriesJson = JsonSerializer.Serialize(Model.SixPeriodRollup.Select(p => p.ESBLRate));
}

<style>
    .report-view-shell {
        min-width: 0;
        overflow-x: clip;
    }

    .report-header-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        flex-shrink: 0;
    }

        .report-header-actions .btn {
            white-space: nowrap;
            flex-shrink: 0;
        }

    .report-filter-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
    }

        .report-filter-actions .btn {
            white-space: nowrap;
            flex: 1 1 auto;
        }

    .report-kpi-value {
        font-variant-numeric: tabular-nums;
        word-break: break-word;
    }

    .report-chart-box {
        position: relative;
        height: 300px;
        width: 100%;
    }

    .phenotype-filter-group .form-check-input {
        cursor: pointer;
    }

    .phenotype-filter-group .form-check-label {
        cursor: pointer;
        user-select: none;
    }

    .phenotype-swatch {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        vertical-align: middle;
        margin-right: 4px;
    }

    /* Prevent Select2 multi-select from overflowing or truncating pills */
    .report-view-shell .select2-container {
        width: 100% !important;
        max-width: 100%;
    }

    .report-view-shell .select2-container--bootstrap-5 .select2-selection--multiple {
        min-height: 31px;
        height: auto !important;
    }

        .report-view-shell .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__rendered {
            display: flex;
            flex-wrap: wrap;
            gap: 0.25rem;
            white-space: normal !important;
        }

        .report-view-shell .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice {
            max-width: 100%;
            white-space: normal;
            word-break: break-word;
        }

    @@media (max-width: 575.98px) {
        .report-header-actions {
            width: 100%;
        }

            .report-header-actions .btn {
                flex: 1 1 calc(50% - 0.25rem);
                justify-content: center;
            }

        .report-chart-box {
            height: 240px;
        }
    }

    @@media print {
        .no-print,
        .sidebar,
        .app-header,
        #sidebarToggle {
            display: none !important;
        }

        .main-content {
            margin: 0 !important;
            padding: 0 !important;
        }

        .report-chart-box {
            height: 260px;
        }
    }
</style>

<div class="container-fluid py-3 report-view-shell">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div class="min-w-0 flex-grow-1">
            <h2 class="mb-1 text-break">Multi-Pathogen AMR Surveillance Reports</h2>
            <p class="text-muted mb-0">
                Standard reporting cycle: <strong>21st to 20th</strong> anchored on sample receiving date
                @if (Model.LatestReceivingDate.HasValue)
                {
                    <span>(Latest recorded sample: <strong>@Model.LatestReceivingDate.Value.ToString("dd MMM yyyy")</strong>)</span>
                }
            </p>
        </div>

        <div class="report-header-actions no-print">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="copyNarrativeHeaderBtn" onclick="copyNarrative(this)">
                <i class="bi bi-clipboard me-1"></i>
                <span class="copy-label">Copy Study Narrative</span>
            </button>
            <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>
                <span>Print / Save PDF</span>
            </button>
        </div>
    </div>

    <!-- Natural Language Query (NLQ) Placeholder -->
    <div class="card border-info bg-light mb-3 no-print">
        <div class="card-body py-2 px-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <div class="d-flex align-items-center flex-wrap gap-2 min-w-0">
                    <i class="bi bi-stars text-primary fs-5 flex-shrink-0"></i>
                    <strong class="text-break">Natural Language Report Assistant (NLQ)</strong>
                    <span class="badge bg-info text-dark flex-shrink-0">Coming Soon</span>
                </div>
                <small class="text-muted">Ask questions in plain English to generate custom surveillance summaries and trends</small>
            </div>
            <div class="input-group input-group-sm flex-nowrap">
                <input type="text"
                       class="form-control min-w-0"
                       disabled
                       placeholder="e.g., &quot;Compare CRE, ESBL, and MDR rates between HAI and CAI across facilities over the last 6 cycles...&quot;"
                       aria-label="Natural language report query placeholder" />
                <button class="btn btn-outline-primary text-nowrap flex-shrink-0" type="button" disabled>
                    <i class="bi bi-send me-1"></i>
                    <span>Ask AI</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Interactive Filter Bar -->
    <div class="card shadow-sm mb-3 no-print">
        <div class="card-body">
            <form method="get" asp-action="Index" id="reportFilterForm" class="row g-3 align-items-end">
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3 min-w-0">
                    <label class="form-label small fw-semibold" for="periodKeySelect">Reporting Cycle (21st – 20th)</label>
                    <select name="periodKey" id="periodKeySelect" class="form-select form-select-sm auto-submit-filter">
                        @foreach (var p in Model.AvailablePeriods)
                        {
                            <option value="@p.Value" selected="@(p.Value == Model.SelectedPeriodKey)">@p.Text</option>
                        }
                        <option value="CUSTOM" selected="@(Model.SelectedPeriodKey == "CUSTOM")">Custom Date Range...</option>
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-lg-3 col-xl-2 min-w-0 @(Model.SelectedPeriodKey == "CUSTOM" ? "" : "d-none")" id="customStartCol">
                    <label class="form-label small fw-semibold" for="customStartInput">Receiving Start</label>
                    <input type="date" name="customStart" id="customStartInput" value="@Model.PeriodStart.ToString("yyyy-MM-dd")" class="form-control form-control-sm custom-date-filter" />
                </div>

                <div class="col-12 col-sm-6 col-lg-3 col-xl-2 min-w-0 @(Model.SelectedPeriodKey == "CUSTOM" ? "" : "d-none")" id="customEndCol">
                    <label class="form-label small fw-semibold" for="customEndInput">Receiving End</label>
                    <input type="date" name="customEnd" id="customEndInput" value="@Model.PeriodEnd.ToString("yyyy-MM-dd")" class="form-control form-control-sm custom-date-filter" />
                </div>

                <div class="col-12 col-sm-6 col-lg-4 col-xl-3 min-w-0">
                    <label class="form-label small fw-semibold" for="facilityFilterSelect">Facilities</label>
                    <select name="facilityIds" id="facilityFilterSelect" class="form-select form-select-sm searchable auto-submit-filter" multiple data-placeholder="All Facilities">
                        @foreach (var f in Model.AvailableFacilities)
                        {
                            <option value="@f.Value" selected="@f.Selected">@f.Text</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-lg-4 col-xl-3 min-w-0">
                    <label class="form-label small fw-semibold" for="organismFilterSelect">Organisms (Distributions &amp; Trends)</label>
                    <select name="organismIds" id="organismFilterSelect" class="form-select form-select-sm searchable auto-submit-filter" multiple data-placeholder="All Organisms">
                        @foreach (var o in Model.AvailableOrganisms)
                        {
                            <option value="@o.Value" selected="@o.Selected">@o.Text</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-lg-4 col-xl-2 min-w-0">
                    <label class="form-label small fw-semibold" for="haiCaiFilterSelect">Infection Origin</label>
                    <select name="haiCai" id="haiCaiFilterSelect" class="form-select form-select-sm auto-submit-filter">
                        <option value="All" selected="@(Model.SelectedHAICAI == "All")">All (HAI &amp; CAI)</option>
                        <option value="HAI" selected="@(Model.SelectedHAICAI == "HAI")">HAI Only</option>
                        <option value="CAI" selected="@(Model.SelectedHAICAI == "CAI")">CAI Only</option>
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-lg-4 col-xl-2 min-w-0">
                    <div class="report-filter-actions">
                        <button type="submit" class="btn btn-primary btn-sm" id="applyFiltersBtn">Apply</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset filters">Reset</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Active Rollup Spike Alerts Banner -->
    @if (Model.ReportRollupSpikes.Any())
    {
        <div class="alert alert-danger shadow-sm mb-3" role="alert">
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <strong class="text-break">6-Period Monthly Rollup Resistance Spike Alert(s) Detected</strong>
            </div>
            <ul class="mb-0 small">
                @foreach (var spike in Model.ReportRollupSpikes)
                {
                    <li class="text-break">@spike.SummaryMessage</li>
                }
            </ul>
        </div>
    }

    <!-- Small Sample Caution Banner -->
    @if (Model.HasSmallSampleCaveats)
    {
        <div class="alert alert-warning py-2 px-3 small mb-3" role="alert">
            <i class="bi bi-info-circle-fill me-1"></i>
            <strong>Statistical Note:</strong> Indicators marked with <span class="badge bg-warning text-dark">n &lt; 15</span> have fewer than 15 evaluated isolates in this window; interpret proportions with caution.
        </div>
    }

    <!-- KPI Summary Row: Patients -> Isolates (G) -> ESKAPE+ -> Reserve Resistance -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6 col-xl-3 min-w-0">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Surveillance Patients</div>
                    <h3 class="mb-1 report-kpi-value">@Model.TotalPatients</h3>
                    <div class="small text-muted">
                        Passive: <strong>@Model.PassivePatientCount</strong> &bull;
                        Active: <strong>@Model.ActivePatientCount</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3 min-w-0">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Recovered Isolates (G)</div>
                    <h3 class="mb-1 report-kpi-value">@Model.TotalIsolatesRecovered</h3>
                    <div class="small text-muted">
                        Active: <strong>@Model.ActiveIsolatesRecovered</strong> &bull;
                        Passive: <strong>@Model.PassiveIsolatesRecovered</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3 min-w-0">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">ESKAPE+ Recovered</div>
                    <h3 class="mb-1 report-kpi-value">
                        @Model.TotalESKAPEERecovered
                        <small class="fs-6 text-muted">(@Model.OverallESKAPEEShareOfIsolates.ToString("F1")%)</small>
                    </h3>
                    <div class="small text-muted">
                        HAI: <strong>@Model.HAICount</strong> &bull;
                        CAI: <strong>@Model.CAICount</strong>
                        @if (Model.UnknownHAICAICount > 0)
                        {
                            <span>&bull; Unspecified: <strong>@Model.UnknownHAICAICount</strong></span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3 min-w-0">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">High-Consequence Reserve Resistance</div>
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                        <h3 class="mb-0 report-kpi-value">
                            @Model.MultiReserveResistantCount / @Model.MultiReserveResistantDenominator
                        </h3>
                        @if (Model.MultiReserveResistantDenominator > 0 && Model.MultiReserveResistantDenominator < 15)
                        {
                            <span class="badge bg-warning text-dark">n &lt; 15</span>
                        }
                    </div>
                    <div class="small text-muted">
                        Isolates resistant to &ge;1 monthly-report reserve agent
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Core Resistance Indicators: Gram-Negative MDR, MRSA, CRE, ESBL -->
    <div class="row g-3 mb-4">
        @{
            var coreCards = new[] { Model.GramNegativeMDR, Model.MRSA, Model.CRE, Model.ESBL };
        }
        @foreach (var card in coreCards)
        {
            <div class="col-12 col-sm-6 col-xl-3 min-w-0">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <h6 class="card-title mb-1 text-break">@card.Title</h6>
                            @if (card.IsSmallSample)
                            {
                                <span class="badge bg-warning text-dark flex-shrink-0" title="Denominator &lt; 15; interpret with caution">n &lt; 15</span>
                            }
                        </div>
                        <p class="text-muted small mb-2 text-break">@card.Subtitle</p>

                        <div class="d-flex align-items-baseline flex-wrap gap-2 mb-2">
                            <span class="fs-3 fw-bold report-kpi-value">@card.Rate.ToString("F1")%</span>
                            <span class="text-muted small">(@card.Numerator/@card.Denominator)</span>
                        </div>

                        <div class="small mb-2 d-flex align-items-center flex-wrap gap-1">
                            <span>Prior cycle: <strong>@card.PriorRate.ToString("F1")%</strong> (@card.PriorNumerator/@card.PriorDenominator)</span>
                            <span class="badge @(card.DeltaPercentagePoints > 0 ? "bg-danger" : card.DeltaPercentagePoints < 0 ? "bg-success" : "bg-secondary")">
                                @(card.DeltaPercentagePoints >= 0 ? "+" : "")@card.DeltaPercentagePoints.ToString("F1")%
                            </span>
                        </div>

                        <div class="border-top pt-2 small text-muted">
                            <div class="text-break">
                                <strong>HAI:</strong> @card.HAINumerator/@card.HAIDenominator (@card.HAIRate.ToString("F1")%)
                                @if (card.IsHAISmallSample)
                                {
                                    <span class="text-warning fw-semibold">*</span>
                                }
                            </div>
                            <div class="text-break">
                                <strong>CAI:</strong> @card.CAINumerator/@card.CAIDenominator (@card.CAIRate.ToString("F1")%)
                                @if (card.IsCAISmallSample)
                                {
                                    <span class="text-warning fw-semibold">*</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 6-Period Monthly Rollup Trends Chart & Table -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="min-w-0">
                <h5 class="mb-0 text-break">6-Period Longitudinal Surveillance Rollup (21st – 20th Cycles)</h5>
                <small class="text-muted">Tracks Patients, Recovered Isolates (G), ESKAPE+, MDR, MRSA, CRE, and ESBL trends across the last 6 reporting periods</small>
            </div>

            <!-- Interactive Phenotype Checkboxes (All 4 selected by default) -->
            <div class="d-flex flex-wrap align-items-center gap-3 phenotype-filter-group no-print" id="sixPeriodPhenotypeToggles">
                <span class="text-muted small fw-semibold">Phenotypes:</span>

                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input js-phenotype-checkbox"
                           type="checkbox"
                           id="chkPhenotypeMDR"
                           data-dataset-index="0"
                           checked />
                    <label class="form-check-label small" for="chkPhenotypeMDR">
                        <span class="phenotype-swatch" style="background-color: #dc3545;"></span>GN-ESKAPEE MDR
                    </label>
                </div>

                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input js-phenotype-checkbox"
                           type="checkbox"
                           id="chkPhenotypeMRSA"
                           data-dataset-index="1"
                           checked />
                    <label class="form-check-label small" for="chkPhenotypeMRSA">
                        <span class="phenotype-swatch" style="background-color: #fd7e14;"></span>MRSA
                    </label>
                </div>

                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input js-phenotype-checkbox"
                           type="checkbox"
                           id="chkPhenotypeCRE"
                           data-dataset-index="2"
                           checked />
                    <label class="form-check-label small" for="chkPhenotypeCRE">
                        <span class="phenotype-swatch" style="background-color: #6f42c1;"></span>CRE
                    </label>
                </div>

                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input js-phenotype-checkbox"
                           type="checkbox"
                           id="chkPhenotypeESBL"
                           data-dataset-index="3"
                           checked />
                    <label class="form-check-label small" for="chkPhenotypeESBL">
                        <span class="phenotype-swatch" style="background-color: #0d6efd;"></span>ESBL
                    </label>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="report-chart-box mb-3">
                <canvas id="sixPeriodTrendChart"
                        data-labels="@chartLabelsJson"
                        data-gn-mdr="@gnMdrSeriesJson"
                        data-mrsa="@mrsaSeriesJson"
                        data-cre="@creSeriesJson"
                        data-esbl="@esblSeriesJson"></canvas>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Reporting Period</th>
                            <th class="text-end">Patients</th>
                            <th class="text-end">Isolates (G)</th>
                            <th class="text-end">ESKAPE+</th>
                            <th class="text-end">GN-ESKAPEE MDR</th>
                            <th class="text-end">MRSA</th>
                            <th class="text-end">CRE</th>
                            <th class="text-end">ESBL</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pt in Model.SixPeriodRollup)
                        {
                            <tr class="@(pt.PeriodKey == Model.SelectedPeriodKey ? "table-primary fw-semibold" : "")">
                                <td class="text-nowrap">@pt.PeriodLabel</td>
                                <td class="text-end text-nowrap">@pt.TotalPatients</td>
                                <td class="text-end text-nowrap">@pt.IsolatesRecovered</td>
                                <td class="text-end text-nowrap">@pt.ESKAPEECount</td>
                                <td class="text-end text-nowrap">
                                    @pt.GnMDRNumerator/@pt.GnMDRDenominator (@pt.GnMDRRate.ToString("F1")%)
                                    @if (pt.GnMDRDenominator > 0 && pt.GnMDRDenominator < 15)
                                    {
                                        <span class="badge bg-warning text-dark">n&lt;15</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @pt.MRSANumerator/@pt.MRSADenominator (@pt.MRSARate.ToString("F1")%)
                                    @if (pt.MRSADenominator > 0 && pt.MRSADenominator < 15)
                                    {
                                        <span class="badge bg-warning text-dark">n&lt;15</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @pt.CRENumerator/@pt.CREDenominator (@pt.CRERate.ToString("F1")%)
                                    @if (pt.CREDenominator > 0 && pt.CREDenominator < 15)
                                    {
                                        <span class="badge bg-warning text-dark">n&lt;15</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @pt.ESBLNumerator/@pt.ESBLDenominator (@pt.ESBLRate.ToString("F1")%)
                                    @if (pt.ESBLDenominator > 0 && pt.ESBLDenominator < 15)
                                    {
                                        <span class="badge bg-warning text-dark">n&lt;15</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Dynamic High-Consequence / Reserve Antibiotics (Managed via Antibiotics Module) -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="min-w-0 flex-grow-1">
                <h5 class="mb-0 text-break">High-Consequence &amp; Reserve Antimicrobial Resistance Profile</h5>
                <small class="text-muted">
                    Dynamically populated from antibiotics marked <strong>Include in Monthly Report</strong> in Reference Data
                </small>
            </div>
            <a asp-controller="Antibiotic" asp-action="Index" class="btn btn-sm btn-outline-primary text-nowrap flex-shrink-0 no-print">
                <i class="bi bi-sliders me-1"></i>
                <span>Configure Reportable Antibiotics</span>
            </a>
        </div>
        <div class="card-body">
            @if (Model.ReportableAntibiotics.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Antibiotic</th>
                                <th>Class</th>
                                <th class="text-end">Resistant / Tested</th>
                                <th class="text-end">Prior Cycle</th>
                                <th class="text-end">HAI</th>
                                <th class="text-end">CAI</th>
                                <th>Organism Breakdown</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var abx in Model.ReportableAntibiotics)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center flex-wrap gap-1">
                                            <strong>@abx.AntibioticName</strong>
                                            <span class="text-muted small">(@abx.AntibioticCode)</span>
                                            @if (abx.IsSmallSample)
                                            {
                                                <span class="badge bg-warning text-dark">n &lt; 15</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="small text-muted">@abx.AntibioticClassName</td>
                                    <td class="text-end fw-semibold text-nowrap">
                                        @abx.ResistantCount/@abx.TestedCount (@abx.ResistanceRate.ToString("F1")%)
                                    </td>
                                    <td class="text-end text-muted small text-nowrap">
                                        @abx.PriorResistantCount/@abx.PriorTestedCount (@abx.PriorResistanceRate.ToString("F1")%)
                                    </td>
                                    <td class="text-end small text-nowrap">
                                        @abx.HAIResistant/@abx.HAITested (@abx.HAIRate.ToString("F1")%)
                                    </td>
                                    <td class="text-end small text-nowrap">
                                        @abx.CAIResistant/@abx.CAITested (@abx.CAIRate.ToString("F1")%)
                                    </td>
                                    <td class="small text-break">
                                        @if (abx.ByOrganism.Any(o => o.Numerator > 0))
                                        {
                                            @string.Join(", ", abx.ByOrganism.Where(o => o.Numerator > 0).Select(o => $"{o.Organism} ({o.Numerator}/{o.Denominator})"))
                                        }
                                        else
                                        {
                                            <span class="text-muted">No resistant isolates</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No antibiotics are currently flagged for monthly reporting. Go to <strong>Reference Data &rarr; Antibiotics</strong> and check <em>Include in Monthly Report</em> on reserve agents (e.g., Meropenem, Ceftazidime-avibactam, Meropenem-vaborbactam, Imipenem-relebactam, Eravacycline).
                </p>
            }
        </div>
    </div>

    <!-- Facility & Pathogen Distributions -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-xxl-6 min-w-0">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0 text-break">Surveillance Breakdown by Facility</h5>
                </div>
                <div class="card-body table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Facility</th>
                                <th class="text-end">Patients (P/A)</th>
                                <th class="text-end">Isolates (G)</th>
                                <th class="text-end">ESKAPE+</th>
                                <th class="text-end">MDR</th>
                                <th class="text-end">MRSA</th>
                                <th class="text-end">CRE</th>
                                <th class="text-end">ESBL</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.FacilityBreakdown)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@f.FacilityName</span>
                                        <small class="text-muted">(@f.FacilityID)</small>
                                    </td>
                                    <td class="text-end text-nowrap">@f.TotalPatients <small class="text-muted">(@f.PassivePatients/@f.ActivePatients)</small></td>
                                    <td class="text-end text-nowrap">@f.IsolatesRecovered</td>
                                    <td class="text-end text-nowrap">@f.ESKAPEERecovered</td>
                                    <td class="text-end text-nowrap">@f.MDRCount</td>
                                    <td class="text-end text-nowrap">@f.MRSACount</td>
                                    <td class="text-end text-nowrap">@f.CRECount</td>
                                    <td class="text-end text-nowrap">@f.ESBLCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12 col-xxl-6 min-w-0">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0 text-break">ESKAPE+ &amp; Other Growth Isolates (Culture = G)</h5>
                </div>
                <div class="card-body table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Organism (WHONETID)</th>
                                <th class="text-end">Isolates</th>
                                <th class="text-end">HAI / CAI</th>
                                <th class="text-end">MDR</th>
                                <th class="text-end">MRSA</th>
                                <th class="text-end">CRE</th>
                                <th class="text-end">ESBL</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.OrganismBreakdown.Concat(Model.NotableOtherOrganisms))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center flex-wrap gap-1">
                                            <em>@o.WHONETID</em>
                                            @if (!o.IsESKAPEE)
                                            {
                                                <span class="badge bg-secondary">Non-ESKAPE+</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end fw-semibold text-nowrap">@o.Count</td>
                                    <td class="text-end small text-nowrap">@o.HAICount / @o.CAICount</td>
                                    <td class="text-end text-nowrap">@o.MDRCount</td>
                                    <td class="text-end text-nowrap">@o.MRSACount</td>
                                    <td class="text-end text-nowrap">@o.CRECount</td>
                                    <td class="text-end text-nowrap">@o.ESBLCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Auto-Generated Study Narrative & Supplemental Findings -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0 text-break">Auto-Generated Study Report Narrative</h5>
            <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap flex-shrink-0 no-print" id="copyNarrativeCardBtn" onclick="copyNarrative(this)">
                <i class="bi bi-clipboard me-1"></i>
                <span class="copy-label">Copy Text</span>
            </button>
        </div>
        <div class="card-body">
            <textarea id="studyNarrativeBox" class="form-control font-monospace small mb-3" rows="10">@Model.GeneratedNarrative</textarea>

            <div class="row g-3">
                <div class="col-12 col-md-6 min-w-0">
                    <label class="form-label small fw-semibold" for="notablePathogensNotes">Supplemental Notes: Notable Pathogens / MIC Alerts (e.g., Candidozyma auris)</label>
                    <textarea id="notablePathogensNotes" class="form-control form-control-sm" rows="3" placeholder="Add manual antifungal MIC or special organism notes for this report export..."></textarea>
                </div>
                <div class="col-12 col-md-6 min-w-0">
                    <label class="form-label small fw-semibold" for="molecularTakeawaysNotes">Supplemental Notes: Molecular / Multiplex PCR &amp; Key Takeaways</label>
                    <textarea id="molecularTakeawaysNotes" class="form-control form-control-sm" rows="3" placeholder="Add multiplex PCR detection / co-infection notes or study takeaways..."></textarea>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const form = document.getElementById('reportFilterForm');
            const periodSelect = document.getElementById('periodKeySelect');
            const customStartCol = document.getElementById('customStartCol');
            const customEndCol = document.getElementById('customEndCol');
            const customStartInput = document.getElementById('customStartInput');
            const customEndInput = document.getElementById('customEndInput');

            let submitTimer = null;
            function submitFilters(delayMs) {
                if (!form) return;
                clearTimeout(submitTimer);
                submitTimer = setTimeout(() => {
                    form.submit();
                }, delayMs);
            }

            if (window.jQuery && window.jQuery.fn.select2) {
                window.jQuery('.searchable').each(function () {
                    const $el = window.jQuery(this);
                    $el.select2({
                        theme: 'bootstrap-5',
                        width: '100%',
                        placeholder: $el.data('placeholder') || 'Select...',
                        allowClear: true,
                        closeOnSelect: false
                    }).on('change', function () {
                        submitFilters(450);
                    });
                });
            }

            periodSelect?.addEventListener('change', function () {
                const isCustom = this.value === 'CUSTOM';
                customStartCol?.classList.toggle('d-none', !isCustom);
                customEndCol?.classList.toggle('d-none', !isCustom);
                if (!isCustom) {
                    submitFilters(100);
                }
            });

            document.querySelectorAll('.custom-date-filter').forEach(input => {
                input.addEventListener('change', function () {
                    if (periodSelect?.value === 'CUSTOM' &&
                        customStartInput?.value &&
                        customEndInput?.value &&
                        customEndInput.value >= customStartInput.value) {
                        submitFilters(250);
                    }
                });
            });

            document.querySelectorAll('.auto-submit-filter').forEach(el => {
                if (el.id === 'periodKeySelect') return;
                if (window.jQuery && window.jQuery.fn.select2 && el.classList.contains('searchable')) return;
                el.addEventListener('change', function () {
                    submitFilters(250);
                });
            });
        })();

        function copyNarrative(triggerBtn) {
            const box = document.getElementById('studyNarrativeBox');
            if (!box) return;

            const text = box.value;
            const onCopied = () => {
                if (!triggerBtn) return;
                const labelEl = triggerBtn.querySelector('.copy-label');
                const iconEl = triggerBtn.querySelector('i');
                if (!labelEl) return;

                const originalText = labelEl.textContent;
                labelEl.textContent = 'Copied!';
                if (iconEl) {
                    iconEl.classList.remove('bi-clipboard');
                    iconEl.classList.add('bi-check2');
                }
                setTimeout(() => {
                    labelEl.textContent = originalText;
                    if (iconEl) {
                        iconEl.classList.remove('bi-check2');
                        iconEl.classList.add('bi-clipboard');
                    }
                }, 1600);
            };

            box.focus();
            box.select();

            if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
                navigator.clipboard.writeText(text)
                    .then(onCopied)
                    .catch(() => {
                        // Text remains selected so the user can press Ctrl+C / Cmd+C manually
                    });
            }
        }

        const ctx = document.getElementById('sixPeriodTrendChart');
        if (ctx) {
            const labels = JSON.parse(ctx.dataset.labels || '[]');
            const gnMdrData = JSON.parse(ctx.dataset.gnMdr || '[]');
            const mrsaData = JSON.parse(ctx.dataset.mrsa || '[]');
            const creData = JSON.parse(ctx.dataset.cre || '[]');
            const esblData = JSON.parse(ctx.dataset.esbl || '[]');

            const allPhenotypeDatasets = [
                {
                    label: 'GN-ESKAPEE MDR (%)',
                    data: gnMdrData,
                    borderColor: '#dc3545',
                    backgroundColor: 'rgba(220, 53, 69, 0.1)',
                    tension: 0.25
                },
                {
                    label: 'MRSA (%)',
                    data: mrsaData,
                    borderColor: '#fd7e14',
                    backgroundColor: 'rgba(253, 126, 20, 0.1)',
                    tension: 0.25
                },
                {
                    label: 'CRE (%)',
                    data: creData,
                    borderColor: '#6f42c1',
                    backgroundColor: 'rgba(111, 66, 193, 0.1)',
                    tension: 0.25
                },
                {
                    label: 'ESBL (%)',
                    data: esblData,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    tension: 0.25
                }
            ];

            const phenotypeCheckboxes = Array.from(document.querySelectorAll('.js-phenotype-checkbox'));

            function getSelectedDatasets() {
                return phenotypeCheckboxes
                    .filter(cb => cb.checked)
                    .map(cb => allPhenotypeDatasets[Number(cb.dataset.datasetIndex)])
                    .filter(Boolean);
            }

            const sixPeriodChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: getSelectedDatasets()
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                boxWidth: 14,
                                padding: 12
                            },
                            onClick: () => {}
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            title: { display: true, text: 'Resistance Rate (%)' }
                        }
                    }
                }
            });

            phenotypeCheckboxes.forEach(cb => {
                cb.addEventListener('change', function () {
                    sixPeriodChart.data.datasets = getSelectedDatasets();
                    sixPeriodChart.update();
                });
            });
        }
    </script>
}