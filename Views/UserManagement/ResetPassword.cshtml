@model AMRSurveillance.ViewModels.AdminPasswordResetViewModel

@{
    ViewData["Title"] = "Administrator Password Reset";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <h2 class="mb-3">Administrator Password Reset</h2>

            <p class="text-muted">
                Select an active user whose identity has been verified.
                The system will generate a temporary password.
            </p>

            <div class="alert alert-warning" role="alert">
                Deliver the temporary password only through an
                approved secure organisational channel.
            </div>

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <form asp-controller="UserManagement"
                  asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="UserId"
                           class="form-label"></label>

                    <select asp-for="UserId"
                            asp-items="ViewBag.Users"
                            class="form-select"
                            required>
                        <option value="">-- Select a user --</option>
                    </select>

                    <span asp-validation-for="UserId"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-danger"
                        onclick="return confirm('Confirm that you have verified this user’s identity and want to reset their password?');">
                    Reset Password
                </button>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
