@{
    ViewData["Title"] = "Password Reset Requires Attention";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <h2 class="mb-3">Password Reset Requires Attention</h2>

            <div class="alert alert-danger" role="alert">
                The password reset process did not complete all required
                steps. Check the account state and application logs, then
                follow the approved recovery procedure.
            </div>

            <a asp-controller="UserManagement"
               asp-action="ResetPassword"
               class="btn btn-primary">
                Return to User Reset
            </a>
        </div>
    </div>
</div>
