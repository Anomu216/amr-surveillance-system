@{
    ViewData["Title"] = "Temporary Password Unavailable";
}

<div class="container mt-4">
    <h2>Temporary Password Unavailable</h2>

    <div class="alert alert-warning" role="alert">
        This temporary password has expired, has already been retrieved,
        or is no longer available. Verify the user's identity again before
        initiating another password reset.
    </div>

    <a asp-controller="UserManagement"
       asp-action="ResetPassword"
       class="btn btn-primary">
        Return to User Reset
    </a>
</div>
