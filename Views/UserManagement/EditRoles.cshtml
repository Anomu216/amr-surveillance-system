@model AMRSurveillance.ViewModels.EditUserRolesViewModel
@{
    ViewData["Title"] = "Reassign User Roles";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Reassign User Roles</h5>
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
                <div class="card-body">
                    <div class="mb-3 p-3 bg-light rounded border">
                        <div><strong>Full Name:</strong> @(string.IsNullOrWhiteSpace(Model.FullName) ? "—" : Model.FullName)</div>
                        <div><strong>Username:</strong> @Model.UserName</div>
                        <div><strong>Email:</strong> @Model.Email</div>
                    </div>

                    <form asp-action="EditRoles" method="post">
                        <input type="hidden" asp-for="UserId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Assigned Roles</label>
                            <div class="border rounded p-3">
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    var isChecked = Model.SelectedRoles.Contains(role.Value);
                                    var isSelfAdminRole = Model.IsCurrentAdmin && role.Value == AMRSurveillance.Security.AppRoles.SystemAdministrator;

                                    <div class="form-check mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedRoles"
                                               value="@role.Value"
                                               id="role_@role.Value"
                                               checked="@isChecked"
                                               disabled="@isSelfAdminRole" />
                                        <label class="form-check-label" for="role_@role.Value">
                                            @role.Text
                                        </label>

                                        @if (isSelfAdminRole)
                                        {
                                            <input type="hidden" name="SelectedRoles" value="@role.Value" />
                                            <small class="text-muted d-block">You cannot remove your own System Administrator role.</small>
                                        }
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="SelectedRoles" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Back to Users</a>
                            <button type="submit" class="btn btn-primary">Save Role Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>