@{
    ViewData["Title"] = "Temporary Password";
    var temporaryPassword = ViewBag.TemporaryPassword as string;
    var resetUserName = ViewBag.ResetUserName as string;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <h2 class="mb-3">Password Reset Successful</h2>

            <div class="alert alert-success" role="alert">
                The temporary password has been generated.
            </div>

            <p>
                <strong>Account:</strong> @resetUserName
            </p>

            <div class="alert alert-warning" role="alert">
                Deliver this password only through an approved secure
                organisational channel. The user must change it before
                accessing normal application modules.
            </div>

            <label for="temporaryPassword" class="form-label">
                Temporary password
            </label>

            <div class="input-group mb-3">
                <input id="temporaryPassword"
                       type="password"
                       class="form-control"
                       value="@temporaryPassword"
                       readonly
                       autocomplete="off" />

                <button type="button"
                        class="btn btn-outline-secondary"
                        id="togglePassword">
                    Show
                </button>

                <button type="button"
                        class="btn btn-outline-primary"
                        id="copyPassword">
                    Copy
                </button>
            </div>

            <p class="small text-muted">
                This password can be retrieved only once. Do not leave
                this screen visible or copy the password to an
                unapproved application.
            </p>

            <a asp-controller="UserManagement"
               asp-action="ResetPassword"
               class="btn btn-primary">
                Return to User Reset
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const passwordInput =
                document.getElementById("temporaryPassword");

            const toggleButton =
                document.getElementById("togglePassword");

            const copyButton =
                document.getElementById("copyPassword");

            toggleButton.addEventListener("click", () => {
                const showing = passwordInput.type === "text";
                passwordInput.type = showing ? "password" : "text";
                toggleButton.textContent = showing ? "Show" : "Hide";
            });

            copyButton.addEventListener("click", async () => {
                try {
                    await navigator.clipboard.writeText(
                        passwordInput.value
                    );

                    copyButton.textContent = "Copied";
                } catch {
                    copyButton.textContent =
                        "Copy unavailable — select manually";
                }
            });
        })();
    </script>
}
