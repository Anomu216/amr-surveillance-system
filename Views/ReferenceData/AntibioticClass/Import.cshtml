@{
    ViewData["Title"] = "Import Antibiotic Categories";
}

<div class="container-fluid">

    <!-- ============================================= -->
    <!-- Page Header -->
    <!-- ============================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Import Antibiotic Categories
            </h2>

            <p class="text-muted mb-0">
                Import antibiotic categories from an Excel workbook.
            </p>

        </div>

        <div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>

                Back

            </a>

        </div>

    </div>


    <!-- ============================================= -->
    <!-- Messages -->
    <!-- ============================================= -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================================= -->
    <!-- Import Instructions -->
    <!-- ============================================= -->

    <div class="row">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        Upload Excel File
                    </h5>

                    <p class="text-muted">
                        Select an Excel workbook containing the antibiotic
                        categories you want to add to the system.
                    </p>


                    <div class="alert alert-info">

                        <div class="fw-semibold mb-1">
                            Excel format
                        </div>

                        The first column should contain:

                        <strong>AntibioticClassName</strong>

                    </div>


                    <form asp-action="Import"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="mb-4">

                            <label for="file"
                                   class="form-label fw-semibold">

                                Excel File

                            </label>

                            <input type="file"
                                   id="file"
                                   name="file"
                                   class="form-control"
                                   accept=".xlsx"
                                   required />

                            <div class="form-text">
                                Only .xlsx files are supported.
                            </div>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-upload"></i>

                                Import

                            </button>

                            <a asp-action="Template"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-file-earmark-excel"></i>

                                Download Template

                            </a>

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>


        <!-- ========================================= -->
        <!-- Import Rules -->
        <!-- ========================================= -->

        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        Import Rules
                    </h5>

                    <ul class="mb-0">

                        <li class="mb-2">
                            The first row is treated as the header.
                        </li>

                        <li class="mb-2">
                            Blank rows are skipped.
                        </li>

                        <li class="mb-2">
                            Existing antibiotic categories are skipped.
                        </li>

                        <li class="mb-2">
                            Only Excel <strong>.xlsx</strong> files are accepted.
                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>