@model IEnumerable<AMRSurveillance.ViewModels.AntibioticClassViewModel>

@{
    ViewData["Title"] = "Antibiotic Categories";
}

<div class="container-fluid">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2 class="mb-1">Antibiotic Categories</h2>

            <p class="text-muted mb-0">
                Manage antibiotic classification reference data.
            </p>
        </div>

        <div>
            <a asp-controller="ReferenceData"
               asp-action="Index"
               class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                <span>Back</span>
            </a>

            <a asp-action="Template"
               class="btn btn-sm btn-outline-secondary">

                <i class="bi bi-file-earmark-excel"></i>
                Template

            </a>

            <a asp-action="Import"
               class="btn btn-sm btn-outline-primary ms-1">

                <i class="bi bi-upload"></i>
                Import

            </a>

            <a asp-action="Create"
               class="btn btn-sm btn-primary ms-1">

                <i class="bi bi-plus-lg"></i>
                Add Antibiotic Class

            </a>

        </div>

    </div>


    <!-- =====================================================
         ALERTS
         ===================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =====================================================
         SEARCH
         ===================================================== -->

    <div class="row mb-3">

        <div class="col-md-6">

            <input type="text"
                   id="searchInput"
                   class="form-control"
                   placeholder="Search antibiotic categories..." />

        </div>

    </div>

    <!-- =====================================================
         TABLE
         ===================================================== -->

    <div class="reference-table-wrapper">
        <table class="table table-hover align-middle reference-table"
               id="antibioticClassTable">

            <thead>
                <tr>
                    <th class="class-name-column">Antibiotic Class</th>
                    <th class="count-column">Antibiotic Count</th>
                    <th class="actions-column">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="class-name-column">
                            @item.AntibioticClassName
                        </td>

                        <td class="count-column">
                            @if (item.AntibioticCount > 0)
                            {
                                <a asp-controller="Antibiotic"
                                   asp-action="Index"
                                   asp-route-antibioticClass="@item.AntibioticClassName"
                                   class="badge bg-primary text-decoration-none antibiotic-count-badge"
                                   title="View antibiotics in @item.AntibioticClassName">
                                    @item.AntibioticCount
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">0</span>
                            }
                        </td>

                        <td class="actions-column">
                            <div class="reference-actions">
                                <a asp-action="Edit"
                                   asp-route-id="@item.AntibioticClassName"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Edit"
                                   aria-label="Edit @item.AntibioticClassName">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        title="Delete"
                                        aria-label="Delete @item.AntibioticClassName"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-class-name="@item.AntibioticClassName">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    

</div>


<!-- =========================================================
     DELETE MODAL
     ========================================================= -->

<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="deleteModalLabel">

                    Confirm Delete

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <p class="mb-1">
                    Are you sure you want to delete this
                    antibiotic class?
                </p>

                <p class="fw-bold mb-0"
                   id="deleteClassName">
                </p>

                <p class="text-muted small mt-2 mb-0">
                    This action cannot be undone.
                </p>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <form asp-action="Delete"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           id="deleteClassId" />

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash"></i>
                        Delete

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     STYLING
     ========================================================= -->

<style>

    .antibiotic-count-badge {
        cursor: pointer;
        transition: opacity 0.15s ease;
        font-size: 0.875rem;
    }

        .antibiotic-count-badge:hover {
            opacity: 0.8;
        }

</style>


@section Scripts
{
    <script>

        // =====================================================
        // SEARCH
        // =====================================================

        document
            .getElementById("searchInput")
            .addEventListener("keyup", function () {

                const searchValue =
                    this.value.toLowerCase();

                const rows =
                    document.querySelectorAll(
                        "#antibioticClassTable tbody tr"
                    );

                rows.forEach(function (row) {

                    const text =
                        row.textContent.toLowerCase();

                    row.style.display =
                        text.includes(searchValue)
                            ? ""
                            : "none";

                });

            });


        // =====================================================
        // DELETE MODAL
        // =====================================================

        const deleteModal =
            document.getElementById("deleteModal");

        deleteModal.addEventListener(
            "show.bs.modal",
            function (event) {

                const button =
                    event.relatedTarget;

                const className =
                    button.getAttribute(
                        "data-class-name"
                    );

                document.getElementById(
                    "deleteClassId"
                ).value = className;

                document.getElementById(
                    "deleteClassName"
                ).textContent = className;

            }
        );

    </script>
}