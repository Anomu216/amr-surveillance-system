@model AMRSurveillance.ViewModels.AntibioticClassViewModel

@{
    ViewData["Title"] = "New Antibiotic Class";
}

<div class="container-fluid">

    <!-- ========================================= -->
    <!-- Page Header -->
    <!-- ========================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                New Antibiotic Class
            </h2>

            <p class="text-muted mb-0">
                Add a new antibiotic class to the reference database.
            </p>

        </div>

        <div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>

                Back

            </a>

        </div>

    </div>

    <!-- ========================================= -->
    <!-- Validation Summary -->
    <!-- ========================================= -->

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <!-- ========================================= -->
    <!-- Create Form -->
    <!-- ========================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div class="row">

                    <div class="col-md-8">

                        <div class="mb-3">

                            <label asp-for="AntibioticClassName"
                                   class="form-label fw-semibold">

                            </label>

                            <input asp-for="AntibioticClassName"
                                   class="form-control"
                                   autofocus
                                   placeholder=" " />

                            <span asp-validation-for="AntibioticClassName"
                                  class="text-danger">

                            </span>

                        </div>

                    </div>

                </div>

                <hr />

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-circle"></i>

                    Save

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-2">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}