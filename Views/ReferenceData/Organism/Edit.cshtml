@model AMRSurveillance.ViewModels.OrganismViewModel

@{
    ViewData["Title"] = "Edit Organism";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Edit Organism
            </h2>

            <p class="text-muted mb-0">
                Update the selected organism.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>

            Back

        </a>

    </div>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="Edit"
                  asp-route-id="@Model.WHONETID"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label asp-for="WHONETID"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="WHONETID"
                           class="form-control"
                           autofocus />

                    <span asp-validation-for="WHONETID"
                          class="text-danger">
                    </span>

                </div>

                <hr />

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-pencil-square"></i>

                    Update

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-2">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}