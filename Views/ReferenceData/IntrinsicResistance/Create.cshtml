@model AMRSurveillance.ViewModels.IntrinsicResistanceViewModel

@{
    ViewData["Title"] = "Add Intrinsic Resistance";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Add Intrinsic Resistance</h2>
            <p class="text-muted mb-0">
                Define an antibiotic to which an organism is intrinsically resistant.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>


    <div class="row">
        <div class="col-lg-8 col-xl-7">

            <div class="card shadow-sm">

                <div class="card-body">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- Organism -->
                        <div class="mb-3">

                            <label asp-for="WHONETID"
                                   class="form-label">
                            </label>

                            <select asp-for="WHONETID"
                                    asp-items="Model.Organisms"
                                    class="form-select">

                                <option value="">
                                    -- Select Organism --
                                </option>

                            </select>

                            <span asp-validation-for="WHONETID"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Antibiotic -->
                        <div class="mb-3">

                            <label asp-for="AntibioticCode"
                                   class="form-label">
                            </label>

                            <select asp-for="AntibioticCode"
                                    asp-items="Model.Antibiotics"
                                    class="form-select">

                                <option value="">
                                    -- Select Antibiotic --
                                </option>

                            </select>

                            <span asp-validation-for="AntibioticCode"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Information -->
                        <div class="alert alert-info">

                            <i class="bi bi-info-circle me-1"></i>

                            This relationship indicates that the selected
                            organism has intrinsic resistance to the selected
                            antibiotic. Intrinsic resistance is excluded from
                            MDR calculations.

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-lg"></i>
                                Add Intrinsic Resistance

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}