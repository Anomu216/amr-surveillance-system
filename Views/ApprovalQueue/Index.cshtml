@model List<AMRSurveillance.Models.DataRequest>

@{
    ViewData["Title"] = "Approval Queue";

    var requesterNames =
        ViewBag.RequesterNames
        as Dictionary<string, string>
        ?? new Dictionary<string, string>();
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- PAGE HEADER                                               -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-clipboard-check me-2"></i>
                Approval Queue
            </h2>

            <p class="text-muted mb-0">
                Review pending data requests and approve or reject them.
            </p>
        </div>

        <span class="badge bg-warning text-dark fs-6">
            @Model.Count Pending
        </span>

    </div>


    <!-- ========================================================= -->
    <!-- SUCCESS / ERROR MESSAGES                                  -->
    <!-- ========================================================= -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>
            @errorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- PENDING REQUESTS                                          -->
    <!-- ========================================================= -->

    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="bi bi-list-task me-2"></i>
                Pending Requests
            </h5>
        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Request #</th>
                                <th>Reason</th>
                                <th>Requested By</th>
                                <th>Requested At</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var request in Model)
                            {
                                <tr>

                                    <!-- REQUEST ID -->
                                    <td>
                                        <strong>
                                            #@request.DataRequestID
                                        </strong>
                                    </td>


                                    <!-- REASON -->
                                    <td style="max-width: 400px;">

                                        @if (!string.IsNullOrWhiteSpace(request.Reason)
                                                                        && request.Reason.Length > 120)
                                        {
                                            <span title="@request.Reason">
                                                @(request.Reason.Substring(0, 120) + "...")
                                            </span>
                                        }
                                        else
                                        {
                                            @request.Reason
                                        }

                                    </td>


                                    <!-- REQUESTING USER -->
                                    <td>
                                        @if (requesterNames.TryGetValue(
                                                                        request.RequestedByUserID,
                                                                        out var requesterName))
                                        {
                                            <span>
                                                <i class="bi bi-person me-1 text-muted"></i>
                                                @requesterName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Unknown User
                                            </span>
                                        }
                                    </td>


                                    <!-- REQUEST DATE (Already stored in EAT) -->
                                    <td class="text-nowrap">
                                        @request.RequestedAt.ToString("dd MMM yyyy HH:mm") EAT
                                    </td>


                                    <!-- REVIEW ACTION -->
                                    <td class="text-center">

                                        <a asp-controller="ApprovalQueue"
                                           asp-action="Review"
                                           asp-route-id="@request.DataRequestID"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-search me-1"></i>
                                            Review

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- ================================================= -->
                <!-- EMPTY STATE                                       -->
                <!-- ================================================= -->

                <div class="text-center py-5">

                    <i class="bi bi-check2-all text-success"
                       style="font-size: 3rem;">
                    </i>

                    <h5 class="mt-3">
                        Approval Queue is Empty
                    </h5>

                    <p class="text-muted mb-0">
                        There are currently no pending data requests
                        awaiting review.
                    </p>

                </div>
            }

        </div>

    </div>

</div>