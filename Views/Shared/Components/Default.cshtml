@model AMRSurveillance.ViewModels.NotificationBellViewModel

<div class="dropdown notification-dropdown">

    <button type="button"
            class="header-notification-button position-relative"
            id="notificationDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Notifications">

        <i class="bi bi-bell" aria-hidden="true"></i>

        @if (Model.UnreadCount > 0)
        {
            <span class="notification-badge">
                @(Model.UnreadCount > 99
                            ? "99+"
                            : Model.UnreadCount.ToString())
        </span>
                }

    </button>


    <div class="dropdown-menu dropdown-menu-end notification-menu"
         aria-labelledby="notificationDropdown">

        <div class="notification-menu-header">
            <div class="d-flex align-items-center gap-2">
                <strong>Notifications</strong>

                @if (Model.UnreadCount > 0)
                {
                    <span class="text-muted small">
                        (@Model.UnreadCount unread)
                    </span>
                }
            </div>

            @if (Model.UnreadCount > 0)
            {
                <form asp-controller="Notification"
                      asp-action="MarkAllRead"
                      method="post"
                      class="m-0">
                    <input type="hidden"
                           name="returnUrl"
                           value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit"
                            class="btn btn-link btn-sm p-0 text-decoration-none">
                        Mark all read
                    </button>
                </form>
            }
        </div>


        <div class="notification-list">

            @if (Model.Notifications.Any())
            {
                @foreach (var notification in Model.Notifications.Take(10))
                {
                    var isSpike =
                    string.Equals(
                    notification.NotificationType,
                    "ResistanceSpike",
                    StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(
                    notification.NotificationType,
                    "MonthlyRollupSpike",
                    StringComparison.OrdinalIgnoreCase);

                    <a asp-controller="Notification"
                       asp-action="Open"
                       asp-route-id="@notification.NotificationID"
                       asp-route-returnUrl="@notification.Link"
                       class="dropdown-item notification-item
                                      @(!notification.IsRead ? "notification-unread" : "")">

                        <div class="d-flex justify-content-between align-items-start gap-2">

                            <strong class="notification-title">
                                @if (isSpike)
                                {
                                    <i class="bi bi-exclamation-diamond-fill text-danger me-1"
                                       aria-hidden="true"></i>
                                }
                                @notification.Title
                            </strong>

                            @if (!notification.IsRead)
                            {
                                <span class="notification-unread-dot"
                                      title="Unread">
                                </span>
                            }

                        </div>

                        <div class="notification-message">
                            @notification.Message
                        </div>

                        <div class="notification-date">
                            @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </div>

                    </a>
                }
            }
            else
            {
                <div class="notification-empty">
                    <i class="bi bi-bell-slash"></i>
                    <span>No notifications yet</span>
                </div>
            }

        </div>

    </div>

</div>