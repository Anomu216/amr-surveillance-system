<header class="app-header d-flex align-items-center justify-content-between">
    <div class="header-left d-flex align-items-center gap-2">
        <button type="button"
                class="sidebar-toggle"
                id="sidebarToggle"
                aria-label="Toggle navigation"
                aria-controls="appSidebar"
                aria-expanded="true"
                title="Toggle sidebar">
            <i class="bi bi-list"></i>
        </button>

        <a asp-controller="Home"
           asp-action="Index"
           class="app-brand">
            <span class="brand-icon-wrap">
                <i class="bi bi-virus2 brand-icon"></i>
            </span>
            <span class="brand-title">AMR Surveillance System</span>
        </a>
    </div>

    <div class="header-right ms-auto d-flex align-items-center gap-2">
        @if (User.Identity?.IsAuthenticated == true)
        {
            var displayName =
            User.FindFirst("FullName")?.Value
            ?? User.Identity.Name
            ?? "User";

            <div class="header-user-pill" title="@displayName">
                <i class="bi bi-person-circle"></i>
                <span class="header-user-name">@displayName</span>
            </div>

            <div class="header-divider d-none d-md-block"></div>

            @await Component.InvokeAsync("NotificationBell")

            <a asp-controller="Account"
               asp-action="ChangePassword"
               class="btn btn-light btn-sm header-account-btn"
               title="Change your password">
                <i class="bi bi-key"></i>
                <span>Change Password</span>
            </a>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="d-inline m-0">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger btn-sm header-account-btn header-signout-btn"
                        title="Sign out of your account">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Sign Out</span>
                </button>
            </form>
        }
    </div>
</header>

<style>
    .header-user-name {
        font-size: 0.875rem;
        font-weight: 500;
        white-space: nowrap;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .header-account-btn {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        line-height: 1.3;
        white-space: nowrap;
    }

    .header-notification-button {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border: 1px solid #dee2e6;
        border-radius: 50%;
        background: #fff;
        color: #495057;
        font-size: 1rem;
        cursor: pointer;
    }

    .header-notification-button:hover {
            background: #f8f9fa;
     }

    /* ============================================================
       NOTIFICATION BADGE
       ============================================================ */

    .notification-badge {
        position: absolute;
        top: -6px;
        right: -7px;
        min-width: 17px;
        height: 17px;
        padding: 0 4px;
        border-radius: 10px;
        background: #dc3545;
        color: #fff;
        font-size: 0.65rem;
        font-weight: 700;
        line-height: 17px;
        text-align: center;
    }


    /* ============================================================
       NOTIFICATION DROPDOWN
       ============================================================ */

    .notification-menu {
        width: 380px;
        max-width: calc(100vw - 24px);
        padding: 0;
        overflow: hidden;
        border: 1px solid #dee2e6;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    .notification-menu-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #dee2e6;
    }

    .notification-list {
        max-height: 420px;
        overflow-y: auto;
    }


    /* ============================================================
       NOTIFICATION ITEMS
       ============================================================ */

    .notification-item {
        display: block;
        padding: 0.75rem 1rem;
        white-space: normal;
        border-bottom: 1px solid #f1f1f1;
    }

        .notification-item:last-child {
            border-bottom: none;
        }

        .notification-item:hover {
            background: #f8f9fa;
        }

    .notification-unread {
        background: #f0f6ff;
    }

    .notification-title {
        display: block;
        font-size: 0.875rem;
        color: #212529;
    }

    .notification-message {
        margin-top: 0.25rem;
        font-size: 0.8rem;
        color: #6c757d;
    }

    .notification-date {
        margin-top: 0.35rem;
        font-size: 0.7rem;
        color: #adb5bd;
    }

    .notification-unread-dot {
        display: inline-block;
        flex-shrink: 0;
        width: 8px;
        height: 8px;
        margin-top: 0.35rem;
        border-radius: 50%;
        background: #0d6efd;
    }


    /* ============================================================
       EMPTY STATE
       ============================================================ */

    .notification-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 2rem 1rem;
        color: #6c757d;
        font-size: 0.875rem;
    }

        .notification-empty i {
            font-size: 1.5rem;
        }

    @@media (max-width: 768px) {
        .header-user-name {
            max-width: 110px;
        }

        .header-account-btn {
            padding: 0.25rem 0.4rem;
        }
    }

    @@media (max-width: 480px) {
        .header-user-name {
            max-width: 85px;
            font-size: 0.75rem;
        }

        .header-account-btn span {
            display: none;
        }

        .header-account-btn {
            width: 30px;
            height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }

            .header-account-btn i {
                margin: 0 !important;
            }
    }
</style>
